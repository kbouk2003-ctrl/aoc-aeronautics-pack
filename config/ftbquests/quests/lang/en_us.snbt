	quest.37E95EED1CA024C8.quest_subtitle: "Load bullets and fire your first gun"
	quest.17EA788DCEAE4BA9.title: "Gun Modifiers"
	quest.17EA788DCEAE4BA9.quest_subtitle: "Install modifiers on a gun to change how it shoots. Fill every slot for a fully loaded gun"
	quest.7521910EE5719D62.title: "The Arsenal"
	quest.7521910EE5719D62.quest_subtitle: "Muskets, blunderbusses and revolvers. There are seven guns in total"
	quest.63BCCF4587AF5A43.title: "&6Tick Tock"
	quest.63BCCF4587AF5A43.quest_subtitle: "The Clockwork Rifle, one of the best guns in the mod"
	quest.6AB73F745DA07D66.title: "Gunslinger Hats"
	quest.6AB73F745DA07D66.quest_subtitle: "The Cowboy Hat and Tricorne give your shooting a little extra"
	chapter.339A8B404A357A40.title: " &dRelics, Artifacts &7\\& &6Arms"
	quest.10E054ED6297A270.title: "&2Witch's Herbs"
	quest.10E054ED6297A270.quest_subtitle: "Hexerei witchcraft starts with gathering herbs in the wild"
	quest.4E92DE08F9D99B07.title: "Drying Rack"
	quest.4E92DE08F9D99B07.quest_subtitle: "Hang herbs to dry them for brewing and crafting"
	quest.7FEFB32527A6D60C.title: "Pestle and Mortar"
	quest.7FEFB32527A6D60C.quest_subtitle: "Grind dried herbs into blends"
	quest.79AF31F2C27F34BE.title: "&2Mixing Cauldron"
	quest.79AF31F2C27F34BE.quest_subtitle: "The heart of a witch's workshop. Mix fluids and ingredients into magic"
	quest.79AF31F2C27F34BE.quest_desc: [
		"JEI lists every mixing recipe and the ingredients each one needs."
	]
	quest.3A38C238BE8FD2A2.title: "Book of Shadows"
	quest.3A38C238BE8FD2A2.quest_subtitle: "Hexerei's guide book. Read it on its altar"
	quest.2746B3F84AB95677.title: "Selenite"
	quest.2746B3F84AB95677.quest_subtitle: "A magic crystal that grows from budding selenite in caves"
	quest.772A109C3EAA419B.title: "&2Fly a Broom"
	quest.772A109C3EAA419B.quest_subtitle: "Ride your own broom. Upgrade it with brushes, tips, seats and satchels"
