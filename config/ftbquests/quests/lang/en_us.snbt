	quest.123855EB973313EA.quest_subtitle: "Faster brushes, tougher tips and satchels to carry your things"
	quest.41E8B8A62D8BF3B5.title: "Crow Familiar"
	quest.41E8B8A62D8BF3B5.quest_subtitle: "Tame a crow and command it with the Crow Flute"
	quest.140EB912847BCE6E.title: "Coffers"
	quest.140EB912847BCE6E.quest_subtitle: "Witchy storage chests. Check JEI for what the Entangled Coffer links to"
	quest.10A883473C3DA899.title: "Crystal Ball"
	quest.10A883473C3DA899.quest_subtitle: "Peer into the unknown"
	quest.477B789D93A10796.title: "&bFerricore"
	quest.477B789D93A10796.quest_subtitle: "Just Dire Things starts with &6Goo&r: special blocks that slowly transform what's next to them"
