		"Goo slowly transforms certain blocks next to it. JEI shows every transformation."
		"Ferricore is the first metal you get this way."
	]
	quest.514A39D635A5FCA1.title: "Primal Goo"
	quest.514A39D635A5FCA1.quest_subtitle: "The first tier of goo"
	quest.706DC3ED9A2BF837.title: "Ferricore Tools"
	quest.706DC3ED9A2BF837.quest_subtitle: "Tools with abilities you can toggle and upgrade"
	quest.229455039B45885C.title: "&6Blazegold"
