	chapter.473F809FD2F0AB8C.title: " &7Bits 'n' Tracks&r"
	quest.0DC56A3D98A90CE8.quest_subtitle: "Build working tank tracks in &6&lCreate&r. Flanged cogwheels carry a belt or tread around them, and on a &bSable&r vehicle, the track grips the ground, drives it along, and rides over what it crosses"
	quest.0DC56A3D98A90CE8.title: "Welcome to &6&lCreate: Bits 'n' Tracks&r!"
	task.5407D44E832085B3.title: "Welcome To Bits N Bobs"
	chapter.63DB18A4DE887E59.title: " &bFrostworks"
	quest.0D0C4F619F6DA58D.title: "Obtain Iron Sheet"
	quest.101D5B1E4F333861.quest_subtitle: "Blows the cold of a &bCold Fluid&r into a &bCold Room&r"
	quest.101D5B1E4F333861.title: "Craft Cold Vent"
	quest.1CC3CF3DA825E447.quest_subtitle: "Gives stored rotation back: turns &bFroisum&r into stress capacity"
	quest.1CC3CF3DA825E447.title: "Craft Expander"
	quest.1F800E2FBB67F59E.title: "Craft &6Mechanical Press"
	quest.20226A40E3632D80.title: "Obtain Frosium Bucket"
	quest.3A0463C854B8A030.quest_subtitle: "A &6press&r that infuses with &bCold&r. Holds one fluid at a time: &bCold Gas&r or &bFrosium&r"
	quest.3A0463C854B8A030.title: "Craft Cryogenic Infuser"
	quest.403532A419123617.title: "Obtain Iron Ingot"
	quest.4294E362D168ABD6.title: "Craft Frost Tank"
	quest.4F12514EC6E1165E.quest_subtitle: "256 RPM is Create's limit. Unless you keep it cold"
	quest.4F12514EC6E1165E.title: "Welcome to &b&lCreate: Frostworks&r!"
	quest.6C09CF7FD767F6AA.quest_subtitle: "Lets the player walk through without opening the &bCold Room&r"
	quest.76735B9D6D5FCFC2.title: "Craft Column Base"
	quest.7A452BE80472B0E5.title: "Craft Compressor"
	quest.7CFFBD8B545C5BE3.title: "Obtain Cold Iron Sheet"
	quest.7D9A83C03F09B32D.quest_subtitle: "Closes a &bCold Room&r. A closed, cooled room lets its machines go past &6&lCreate&r's speed limit"
	quest.7D9A83C03F09B32D.title: "Craft Cold Wall"
	task.2580903E68006A2E.title: "Welcome To FrostWork"
	chapter_group.3007F5F02BA780CD.title: "&5&l&nAdventure \\& Magic"
	chapter_group.2E7DE7DF3538D0B0.title: "&2&l&nWildlife"
	quest.5B7C9793F7DC7810.title: "&6Cannon Mount"
	quest.5B7C9793F7DC7810.quest_subtitle: "Every big cannon sits on a &6Cannon Mount&r to be assembled, aimed and fired"
	quest.5B7C9793F7DC7810.quest_desc: [
		"Build the cannon in front of the mount, then &epower the hammer face&r with redstone to assemble it."
		""
		"Power the mount with &erotation&r to aim up/down and side to side."
	]
	quest.7C22B6C2AA592D87.title: "A Humble Start"
	quest.7C22B6C2AA592D87.quest_subtitle: "A &6Log Cannon Chamber&r is the cheapest cannon you can build: logs and gunpowder"
	quest.7C22B6C2AA592D87.quest_desc: [
		"Craft it from logs and gunpowder and place it in front of your Cannon Mount."
		"Next: make powder charges and a shot to fire it."
	]
	quest.2D3D41C7BE828178.title: "&6Powder Charges"
	quest.2D3D41C7BE828178.quest_subtitle: "Big cannons fire with &6Powder Charges&r"
	quest.2D3D41C7BE828178.quest_desc: [
		"&eCompact&r gunpowder into &6Packed Gunpowder&r, then combine it with an &6Empty Powder Charge&r."
		""
		"More charges behind a shot means more range, but too many can burst a weak cannon."
	]
	quest.2027DAC1D2A54C44.title: "&6Solid Shot"
	quest.2027DAC1D2A54C44.quest_subtitle: "High penetrating force. Best against wooden structures and thin walls"
	quest.2027DAC1D2A54C44.quest_desc: [
		"Craft from iron, wooden slabs and iron nuggets."
		"Load order: charges first, then the shot."
	]
	quest.4413401EC0867BEF.title: "Handloading Tools"
	quest.4413401EC0867BEF.quest_subtitle: "The &6Ram Rod&r pushes munitions into the cannon, the &6Worm&r pulls them back out"
	quest.4413401EC0867BEF.quest_desc: [
		"Both cost a little hunger per block pushed or pulled."
		"Munitions can also be inserted directly into an assembled cannon."
	]
	quest.462F25AA71456250.title: "&eFire!"
	quest.462F25AA71456250.quest_subtitle: "Load a charge, then a shot, assemble, aim and fire"
	quest.462F25AA71456250.quest_desc: [
		"&ePower the hammer face&r to assemble the cannon."
		"&ePower the lit cannon face&r on the mount to fire."
		"&eUnpower the hammer face&r to disassemble it and reload for the next shot."
	]
	quest.7F8D58D89739F96C.title: "&6Cast Iron"
	quest.7F8D58D89739F96C.quest_subtitle: "&eCompact&r iron with coal over heat, or cast it from molten cast iron"
	quest.7F8D58D89739F96C.quest_desc: [
		"&eCompact&r iron with coal in a heated basin (Blaze Burner under it)."
		"Next: a Basin Foundry Lid to melt it for casting."
	]
	quest.5592FE1BEBEEE094.title: "&6Basin Foundry"
	quest.5592FE1BEBEEE094.quest_subtitle: "Put a &6Basin Foundry Lid&r on a &cheated&r basin to melt metal for cannon casting"
	quest.5592FE1BEBEEE094.quest_desc: [
		"Put the lid on a basin over a Blaze Burner, then add cast iron to melt it."
		"Next: build a Cast Mould around where the cannon block will be."
	]
	quest.7D6183F4AA41EB8C.title: "Cannon Moulds"
	quest.7D6183F4AA41EB8C.quest_subtitle: "Use a &6Cast Mould&r to build a cast layer, then fill it with &6molten metal&r"
	quest.7D6183F4AA41EB8C.quest_desc: [
		"Each cannon part has its own mould. Deployers can also work cannon casts."
		"Fill the cast with molten metal from the foundry and wait for it to set."
	]
	quest.231EE3E6E89DB76D.title: "Fresh From the Cast"
	quest.231EE3E6E89DB76D.quest_subtitle: "A cast cannon block still has to be &ebored out&r before it works"
	quest.231EE3E6E89DB76D.quest_desc: [
		"Fill a cast with molten metal and wait for it to cool."
		"Next: bore it out with a Cannon Drill."
	]
	quest.6D1A79EB0A7BCE18.title: "&6Cannon Drill"
	quest.6D1A79EB0A7BCE18.quest_subtitle: "Bores out cast cannon blocks"
	quest.6D1A79EB0A7BCE18.quest_desc: [
		"Set the cannon block spinning on a lathe, point the drill at it, and run both at the same speed."
	]
	quest.1515D9DB0BDE0E83.title: "A Real Cannon"
	quest.1515D9DB0BDE0E83.quest_subtitle: "&6Cast Iron&r barrels and chambers hold far more powder than logs"
	quest.1515D9DB0BDE0E83.quest_desc: [
		"Stack barrels and a chamber in front of the mount. More barrel length means more range."
		"Next: a breech, or straight to firing."
	]
	quest.2E0C07C8A53E7439.title: "&6Sliding Breech"
	quest.2E0C07C8A53E7439.quest_subtitle: "Load from the back of the cannon instead of the muzzle"
	quest.2E0C07C8A53E7439.quest_desc: [
		"Bore an unbored breech, then put it at the back of the cannon."
		"It lets loaders push ammo in from behind."
	]
	quest.66BCF51390EBC934.title: "&6Cannon Loader"
	quest.66BCF51390EBC934.quest_subtitle: "Works like a &6Mechanical Piston&r and extends with Piston Extension Poles"
	quest.66BCF51390EBC934.quest_desc: [
		"Fit a &6Ram Head&r to push munitions in."
		"Swap to a &6Worm Head&r if the cannon jams."
	]
	quest.22076ACFA598D40E.title: "&cHigh Explosive"
	quest.22076ACFA598D40E.quest_subtitle: "Shells need a &6fuze&r on the front to detonate"
	quest.22076ACFA598D40E.quest_desc: [
		"An &6HE Shell&r explodes with a bit more power than TNT."
		"An &6Impact Fuze&r detonates on hit, but not always, and never on grazes."
	]
	quest.33517A5265A62BE8.title: "Ammunition Locker"
	quest.33517A5265A62BE8.quest_subtitle: "AP pierces armor, shrapnel covers an area, smoke hides you, grapeshot shreds wood"
	quest.33517A5265A62BE8.quest_desc: [
		"Each shell is crafted in a Mechanical Crafter or crafting table; JEI shows each recipe."
		"Fuze-able shells need a fuze on the front."
	]
	quest.3FA1C507B6CD2926.title: "Better Fuzes"
	quest.3FA1C507B6CD2926.quest_subtitle: "&eRight-click&r timed and delayed fuzes to set their timing"
	quest.3FA1C507B6CD2926.quest_desc: [
		"Craft a fuze, then combine it with a shell. Impact fuzes are simplest; proximity fuzes are best against airships."
	]
	quest.405F27C919EE80C1.title: "&7Steel"
	quest.405F27C919EE80C1.quest_subtitle: "&eMix&r iron with coal over heat"
	quest.405F27C919EE80C1.quest_desc: [
		"&eMix&r iron and coal in a heated basin."
		"Steel is used for built-up cannons and stronger parts."
	]
	quest.698D002F4C02C925.title: "&6Cannon Builder"
	quest.698D002F4C02C925.quest_subtitle: "Puts together the layers of &7built-up&r cannons"
	quest.698D002F4C02C925.quest_desc: [
		"&ePulse&r it with power to toggle whether it grabs a layer."
		"It always grabs the outermost layer of a built-up block."
	]
	quest.5093F052082CBEB1.title: "&7Built-Up Steel"
	quest.5093F052082CBEB1.quest_subtitle: "The strongest cannons, heated together layer by layer"
	quest.5093F052082CBEB1.quest_desc: [
		"Blast the finished layers with a fan blowing through lava, like bulk blasting."
		"Every layer has to be there, and the heating takes a while."
	]
	quest.3C54B5711EBF6754.title: "&6Autocannons"
	quest.3C54B5711EBF6754.quest_subtitle: "Rapid-fire guns for anti-air and light targets"
	quest.3C54B5711EBF6754.quest_desc: [
		"Wrench the barrel end to change its look and the breech to add handles."
		"Recoil springs make the barrel kick back when firing."
	]
	quest.797CFE0F41B844B1.title: "&6Flak"
	quest.797CFE0F41B844B1.quest_subtitle: "Shoots down airborne targets with a burst of shrapnel. Perfect against airships"
	quest.797CFE0F41B844B1.quest_desc: [
		"Load flak rounds into an autocannon (or its ammo container)."
		"Great for shooting down enemy airships."
	]
	quest.56DD26192DFA02D0.title: "&bRadar Bearing"
	quest.56DD26192DFA02D0.quest_subtitle: "The base of a rotating radar"
	quest.56DD26192DFA02D0.quest_desc: [
		"Place the bearing, add a &6Radar Receiver&r, then &6Radar Dishes&r or &6Plates&r."
		"More dishes and plates extend range. &ePower the bearing&r to spin it."
	]
	quest.725A536A6192B1C7.title: "Receiver and Plates"
	quest.725A536A6192B1C7.quest_subtitle: "Dishes and plates are interchangeable; each one adds range"
	quest.725A536A6192B1C7.quest_desc: [
		"Put the receiver on the radar bearing, then add plates or dishes around it."
		"Next: a Monitor to see contacts."
	]
	quest.791787C67FE96649.title: "&bMonitor"
	quest.791787C67FE96649.quest_subtitle: "Shows what the radar sees. Link it to a radar with a &6Data Link&r"
	quest.791787C67FE96649.quest_desc: [
		"Place it near your radar, then connect the two with a Data Link."
		"Several monitors can be placed together."
	]
	quest.4D7C3C14F7603397.title: "&6Data Links"
	quest.4D7C3C14F7603397.quest_subtitle: "Connect radars, monitors and weapons. &eRight-click&r a link to configure it"
	quest.4D7C3C14F7603397.quest_desc: [
		"Click the radar, then the monitor (or controller) with a Data Link to connect them."
		"Right-click a placed link to change its settings."
	]
	quest.1711CA68EA91D376.title: "Network Controller"
	quest.1711CA68EA91D376.quest_subtitle: "The brain of a radar network"
	quest.1711CA68EA91D376.quest_desc: [
		"A &6Targeting Filter&r inside it enables auto-targeting."
		"Detection and Identification filters hide mobs, players or friendly ships."
	]
	quest.56D9031F6EEF20D3.title: "Auto-Aim"
	quest.56D9031F6EEF20D3.quest_subtitle: "Yaw goes under the cannon mount, pitch beside it"
	quest.56D9031F6EEF20D3.quest_desc: [
		"With a Data Link, select the &6Network Controller&r, then the &6Cannon Mount&r, then the &6Auto Pitch&r to link them."
		"Pick a target on the monitor and the turret aims itself."
	]
	quest.4DA3C3BCA40AAC2F.title: "&cAutomated Turret"
	quest.4DA3C3BCA40AAC2F.quest_subtitle: "Emits a redstone signal when the linked cannon mount is aligned"
	quest.4DA3C3BCA40AAC2F.quest_desc: [
		"Wire it to the lit cannon face (or a quick-firing breech) for a turret that fires on its own."
	]
	quest.5089CE67B2B40AD2.title: "&6Binoculars"
	quest.5089CE67B2B40AD2.quest_subtitle: "&eSneak-right-click&r a Network Controller to pair, then aim connected cannons by hand"
	quest.5089CE67B2B40AD2.quest_desc: [
		"Pair them with a Network Controller, then look at a target to aim linked cannons manually."
	]
	quest.5CBBFF24D20BFDFC.title: "&bPlane Radar"
	quest.5CBBFF24D20BFDFC.quest_subtitle: "Compact radar for ships: no rotation needed, scans a 45-degree cone out to 256 blocks"
	quest.5CBBFF24D20BFDFC.quest_desc: [
		"Build it from a Radar Dish and Radar Receiver. Link it to a Network Controller with a Data Link."
		"It faces the way the ship faces."
	]
	quest.5DADB0F74EF68032.title: "Friend or Foe"
	quest.5DADB0F74EF68032.quest_subtitle: "Name your ship and give it a code so friendly radars never auto-target it"
	quest.5DADB0F74EF68032.quest_desc: [
		"Place it on your ship and set a name and code."
		"Add the same code to the Identification Filter in your Network Controller so your turrets ignore it."
	]
	chapter.4859D88DB1EBFFC6.title: " &cBig Cannons &7\\& &bRadars"
	quest.5A674F9EAFAC754D.title: "&5Raw Noctite"
	quest.5A674F9EAFAC754D.quest_subtitle: "Found in &dThe End&r. Everything rift-related starts here"
	quest.5A674F9EAFAC754D.quest_desc: [
		"Head to &dThe End&r and mine Raw Noctite."
		"Next: haunt it into Unstable Noctite."
	]
	quest.1CD5A45BA4197925.title: "Unstable Noctite"
	quest.1CD5A45BA4197925.quest_subtitle: "&eHaunt&r Raw Noctite with a fan blowing through soul fire"
	quest.1CD5A45BA4197925.quest_desc: [
		"Careful: carrying too many unstable ingots is a bad idea."
	]
	quest.7A075CED67D93919.title: "&5Noctite Ingot"
	quest.7A075CED67D93919.quest_subtitle: "&eDeploy&r a &6Sturdy Sheet&r onto an Unstable Noctite Ingot to stabilize it"
	quest.7A075CED67D93919.quest_desc: [
		"Set a Deployer holding Sturdy Sheets over a depot with Unstable Noctite Ingots."
		"Noctite is used in almost every rift machine."
	]
	quest.558182DA942C5E0C.title: "Noctite Casing"
	quest.558182DA942C5E0C.quest_subtitle: "Apply a Noctite Ingot to an &6Industrial Iron Block&r"
	quest.558182DA942C5E0C.quest_desc: [
		"Right-click an Industrial Iron Block with a Noctite Ingot (or use a Deployer)."
		"Casings form every rift machine frame."
	]
	quest.742B421F404A74EE.title: "Coils and Lenses"
	quest.742B421F404A74EE.quest_subtitle: "The two components almost every rift machine needs"
	quest.742B421F404A74EE.quest_desc: [
		"Resonance Coils use polished rose quartz, unstable noctite and brass sheet. Spatial Lenses use noctite, an eye of ender, glass and rose quartz."
	]
	quest.6544CB147985FF81.title: "&dStabilized Phase Fluid"
	quest.6544CB147985FF81.quest_subtitle: "The Rift Engine's fuel"
	quest.6544CB147985FF81.quest_desc: [
		"&eMix&r a Noctite Ingot into lava, or an Ender Pearl into Unstable Phase Slurry."
		"If you catch phase blight, eat &6Phasing Stew&r to cure it."
	]
	quest.2A2BDF4F084D2AEC.title: "Phase Catalyst"
	quest.2A2BDF4F084D2AEC.quest_subtitle: "&eMix&r a Noctite Ingot into Stabilized Phase Fluid"
	quest.2A2BDF4F084D2AEC.quest_desc: [
		"&eMix&r a Noctite Ingot with Stabilized Phase Fluid in a basin."
		"Needed for the Rift Heart and stasis machines."
	]
	quest.499A8CA3E83298B9.title: "&5Rift Heart"
	quest.499A8CA3E83298B9.quest_subtitle: "Needs a &6Netherite Ingot&r, an Eye of Ender, a Spatial Lens and a Phase Catalyst"
	quest.499A8CA3E83298B9.quest_desc: [
		"Craft it with a netherite ingot, eye of ender, spatial lens, noctite and a phase catalyst."
		"It powers the Rift Engine Core."
	]
	quest.3DF753FD3B9DE27F.title: "&5The Rift Engine"
	quest.3DF753FD3B9DE27F.quest_subtitle: "A 5x5 jump drive that teleports your whole ship"
	quest.3DF753FD3B9DE27F.quest_desc: [
		"Place the &6Rift Engine Base&r first, then build the rest around it."
		"&eSneak-right-click&r the Base with a &6Wrench&r to build the whole engine at once from your inventory."
	]
	quest.6E9D53F18E974CC2.title: "Rift Anchor"
	quest.6E9D53F18E974CC2.quest_subtitle: "Marks a jump destination for your ship"
	quest.6E9D53F18E974CC2.quest_desc: [
		"Place it where you want to arrive, then pick it as the destination on the Engine Console."
	]
	quest.7A96E37687ED9DC6.title: "&dFirst Jump"
	quest.7A96E37687ED9DC6.quest_subtitle: "Fuel the engine, pick a destination at the Console and jump"
	quest.7A96E37687ED9DC6.quest_desc: [
		"The &6Core&r heats up with every jump. Fans blowing at it cool it down; fans with ice, snow or water nearby cool it much faster."
		"An overheated Core can misfire and throw your ship into &5The Rift&r."
		"A ship that is roped, locked, docked or out of fuel can't jump."
	]
	quest.2F43E4590128C3EF.title: "Here, Boy!"
	quest.2F43E4590128C3EF.quest_subtitle: "&eSneak-right-click&r a Console to bind it, then start jumps or call your ship from anywhere"
	quest.2F43E4590128C3EF.quest_desc: [
		"Bind it by sneak-right-clicking the Rift Engine Console."
		"Use it to jump or call your ship to you."
	]
	quest.6992D2AD13721BED.title: "&5Corrupted Shard"
	quest.6992D2AD13721BED.quest_subtitle: "Use it on a Rift Engine Core to unlock &dinterdimensional&r jumps"
	quest.6992D2AD13721BED.quest_desc: [
		"JEI shows where Corrupted Shards come from. Apply one to the Rift Engine Core."
		"They are also needed for the A.P.E.X. Unit and remote."
	]
	quest.638169D0126299FF.title: "Shulker Wrangler"
	quest.638169D0126299FF.quest_subtitle: "Catch a Shulker with an &6Empty Shulker Burner&r"
	quest.638169D0126299FF.quest_desc: [
		"Craft an Empty Shulker Burner and use it on a shulker in the End."
	]
	quest.3413DDB5C66A93B9.title: "Phase Fluid Tank"
	quest.3413DDB5C66A93B9.quest_subtitle: "Feeds phase fluid to slipgates, stasis devices and drives"
	quest.3413DDB5C66A93B9.quest_desc: [
		"Craft it from noctite, a noctite casing and a fluid tank. Fill it with Stabilized Phase Fluid."
	]
	quest.2BE331FCF202EB41.title: "&bSlipgates"
	quest.2BE331FCF202EB41.quest_subtitle: "Teleport items or fluids to a linked gate on the same frequency, even across dimensions"
	quest.2BE331FCF202EB41.quest_desc: [
		"Place two gates and give them the same frequency. Whatever goes into one comes out the other, even in another dimension."
	]
	quest.32BC428A06F9B7B5.title: "Phase Sticker"
	quest.32BC428A06F9B7B5.quest_subtitle: "Each redstone pulse locks or releases your ship in place, even in midair"
	quest.32BC428A06F9B7B5.quest_desc: [
		"Heavy ships need more than one. A locked ship can't make a Rift jump."
	]
	quest.13CC4677811F1F72.title: "&bStasis"
	quest.13CC4677811F1F72.quest_subtitle: "A &6Stasis Core&r makes your ship weightless; a &6Stasis Field&r catches other ships"
	quest.13CC4677811F1F72.quest_desc: [
		"Stasis Core: put it on your ship and power it to cancel weight."
		"Stasis Field: aim it at another ship to hold it."
	]
	quest.1088703E8F6D09D5.title: "Ship Gadgets"
	quest.1088703E8F6D09D5.quest_subtitle: "Repulsor Fields, Tether Winches, Pulse Drives and Haulers. Check &ePonder&r for each"
	quest.1088703E8F6D09D5.quest_desc: [
		"Each gadget runs on phase fluid from a Phase Fluid Tank. Ponder shows how each one works."
	]
	quest.7EFC83F69A99504C.title: "&6A.P.E.X. Unit"
	quest.7EFC83F69A99504C.quest_subtitle: "Cages an anomaly and turns it into rotation with a huge stress capacity"
	quest.7EFC83F69A99504C.quest_desc: [
		"Run it up to &elevel 9&r for the Nexus chain. Check its stress output with Goggles."
	]
	quest.7CB6DCA0F0AD91F4.title: "Rift Ichor"
	quest.7CB6DCA0F0AD91F4.quest_subtitle: "At level 9, an &6Anomaly Manipulator&r below the anomaly collects &dRift Ichor Chunks&r"
	quest.7CB6DCA0F0AD91F4.quest_desc: [
		"They land in the Base. Pull them out with a funnel."
	]
	quest.40E2C64031BE733F.title: "&6A.P.E.X. Nexus"
	quest.40E2C64031BE733F.quest_subtitle: "Powered by two level 9 A.P.E.X. Units. Its cube eats items, mobs and ships"
	quest.40E2C64031BE733F.quest_desc: [
		"Place it between two A.P.E.X. Units running at level 9."
		"Sneak-right-click with a wrench to build its 3x3 base."
	]
	quest.4C78389E8A39DCB7.title: "&dSomething From Nothing"
	quest.4C78389E8A39DCB7.quest_subtitle: "Extremely dense matter made by the Nexus. Hold it while sneaking near the Nexus to fully heal"
	quest.4C78389E8A39DCB7.quest_desc: [
		"The Nexus makes Primordium over time. Compact it with obsidian into a Primordial Heavy Core."
	]
	chapter.44FD3934E90E5AB1.title: " &5Riftborne"
	quest.4487E5A470B5E765.title: "&bBeyond the Basics"
	quest.4487E5A470B5E765.quest_subtitle: "Addons that give your ships and vehicles better controls, new movement and new tools"
	quest.4487E5A470B5E765.quest_desc: [
		"Each branch is optional. Start with whatever you are building next."
	]
	quest.7DC39B88C3A26072.title: "&6Control Consoles"
	quest.7DC39B88C3A26072.quest_subtitle: "Build a cockpit out of real levers, wheels and joysticks"
	quest.7DC39B88C3A26072.quest_desc: [
		"&eRight-click&r with an empty hand to take control. Keyboard and mouse move the mounted controls."
		"Each direction sends on its own &6Redstone Link&r frequency."
		"&eSneak-right-click&r to set key binds and frequencies. Touching consoles work together as one deck."
	]
	quest.60D383B73FEB9246.title: "Control Modules"
	quest.60D383B73FEB9246.quest_subtitle: "Mount modules on a console. &eSneak-right-click the air&r to configure a held module"
	quest.60D383B73FEB9246.quest_desc: [
		"Hold a module and right-click a Control Desk or Stand to mount it."
		"Each module sends its own redstone link signals."
	]
	quest.73A456AB6899E83E.title: "Servos and Gyroscopes"
	quest.73A456AB6899E83E.quest_subtitle: "Turn console inputs into precise movement and stability"
	quest.73A456AB6899E83E.quest_desc: [
		"Wire servos to console outputs to turn inputs into precise rotation."
		"Check Ponder for each block."
	]
	quest.60A5B126E7FAC9A8.title: "&6Drive-by-Wire"
	quest.60A5B126E7FAC9A8.quest_subtitle: "Run redstone over &6Cables&r on an assembled ship instead of long redstone lines"
	quest.60A5B126E7FAC9A8.quest_desc: [
		"Hold Cables and scroll to pick a channel when wiring a lectern controller: each key gets its own channel."
		"Made a mess? The &6Cable Cutter&r removes them all."
	]
	quest.4BF0A81685432AFB.title: "Remote Control"
	quest.4BF0A81685432AFB.quest_subtitle: "Bind your controller to a &6Controller Hub&r and drive the network from far away"
	quest.4BF0A81685432AFB.quest_desc: [
		"Place a Controller Hub on your cable network and bind a linked controller to it."
	]
	quest.20DF7575772D5E75.title: "Network Backup"
	quest.20DF7575772D5E75.quest_subtitle: "Saves cable links into schematics and restores them when the ship comes back"
	quest.20DF7575772D5E75.quest_desc: [
		"Place it on a ship with cables so its links survive saving and reloading."
	]
	quest.770698375D87B0AE.title: "&6Track Mount"
	quest.770698375D87B0AE.quest_subtitle: "&eRight-click&r it with track parts to attach suspension tracks or drive wheels"
	quest.770698375D87B0AE.quest_desc: [
		"Hold track parts and &eright-click&r the mount. Several mounts in a row make one long tread."
	]
	quest.1C14E3235F6C232A.title: "Tank Treads"
	quest.1C14E3235F6C232A.quest_subtitle: "Tracked ground travel for heavy vehicles"
	quest.1C14E3235F6C232A.quest_desc: [
		"Right-click a Track Mount with suspension tracks or drive wheels. Power the drive wheel to move."
	]
	quest.4F4D0FF61C9C516F.title: "Suspension Key"
	quest.4F4D0FF61C9C516F.quest_subtitle: "Tunes track and wheel suspension across connected mounts. &eRight-click the air&r to cycle modes"
	quest.4F4D0FF61C9C516F.quest_desc: [
		"Hold it and right-click the air to pick a setting, then use it on a mount to tune it."
	]
	quest.42F212E0846C55F6.title: "&6Linear Bearing"
	quest.42F212E0846C55F6.quest_subtitle: "Slides a structure along a straight line, like a piston for physics objects"
	quest.42F212E0846C55F6.quest_desc: [
		"Place it, attach the structure to slide, and power it with rotation."
		"Ponder shows how it moves."
	]
	quest.79D5B48262415F5B.title: "Bearing Accessories"
	quest.79D5B48262415F5B.quest_subtitle: "Anchors, ports and converters for linear-bearing builds"
	quest.79D5B48262415F5B.quest_desc: [
		"Accessories for linear bearings. Check JEI and Ponder for each."
	]
	quest.6A0A613C3F7BE02D.title: "Gyroscopic Gearbox"
	quest.6A0A613C3F7BE02D.quest_subtitle: "Apply a &6Gyroscopic Mechanism&r to a Brass Casing so it ignores the rotation of the structure it sits on"
	quest.6A0A613C3F7BE02D.quest_desc: [
		"Right-click a Brass Casing with a Gyroscopic Mechanism."
		"It keeps rotation steady on a tilting ship."
	]
	quest.631FE19803FE6ACA.title: "&cGo-Karts"
	quest.631FE19803FE6ACA.quest_subtitle: "Karts are built by &eSequenced Assembly&r: Deployers above a Depot or Belt"
	quest.631FE19803FE6ACA.quest_desc: [
		"Tip: set up the Deployers once and you can mass-produce karts for races."
	]
	quest.426043C08F6938F3.title: "Track Day"
	quest.426043C08F6938F3.quest_subtitle: "Glue Applicators replace a floor block and coat kart wheels: grip or slide like ice"
	quest.426043C08F6938F3.quest_desc: [
		"Replace a floor block with the applicator, then right-click it with Super Glue or Super Ice."
	]
	quest.2BB1FAF24BAF40EF.title: "&6Pneumatics"
	quest.2BB1FAF24BAF40EF.quest_subtitle: "Pneumatic rods push and pull between two structures; the regulator controls them"
	quest.2BB1FAF24BAF40EF.quest_desc: [
		"Check &ePonder&r for rod properties, settings and hinge heads."
	]
	quest.578BB6B7C7A78B6B.title: "Universal Joints"
	quest.578BB6B7C7A78B6B.quest_subtitle: "Carry rotation between two moving structures"
	quest.578BB6B7C7A78B6B.quest_desc: [
		"Connect two shafts on different structures with a joint rod."
		"Ponder shows the variants."
	]
	quest.1BC68CCB937878EE.title: "Kinetic Conversion Bearing"
	quest.1BC68CCB937878EE.quest_subtitle: "Links a moving structure to rotational power. See &ePonder&r for how its output works"
	quest.1BC68CCB937878EE.quest_desc: [
		"Place it where a moving structure meets your machinery."
		"See its Ponder for exactly how its output works."
	]
	quest.3BE55608577361CF.title: "Transmission Chains"
	quest.3BE55608577361CF.quest_subtitle: "A slim alternative to chain drives for powering belts. Can be encased"
	quest.3BE55608577361CF.quest_desc: [
		"Right-click two belts with chains to link them. Use a wrench to remove casing."
	]
	quest.4A280853246EEE08.title: "&6Magnetic Gun"
	quest.4A280853246EEE08.quest_subtitle: "Drag physical structures up to 24 blocks away. Loses durability while holding"
	quest.4A280853246EEE08.quest_desc: [
		"Hold right-click on a physical structure to drag it."
		"Next: upgrade it into the Structure Tool."
	]
	quest.7A5066A7E217E3F0.title: "Structure Tool"
	quest.7A5066A7E217E3F0.quest_subtitle: "Save, weld, move, rotate and disconnect physical structures. Switch modes with &eTab&r"
	quest.7A5066A7E217E3F0.quest_desc: [
		"Tab switches modes. This survival version can save, weld, move, rotate and disconnect, but not load or delete."
	]
	quest.2E3E3781BFF083BA.title: "Ship in a Bottle"
	quest.2E3E3781BFF083BA.quest_subtitle: "Stores one whole physical structure inside an item"
	quest.2E3E3781BFF083BA.quest_desc: [
		"Use the Structure Tool to save a structure into it, then place it again later."
	]
	quest.1D3CD000706C0C39.title: "&6Rope Launcher"
	quest.1D3CD000706C0C39.quest_subtitle: "Fire a rope to an anchor point. Hold Throwable Rope Connectors in your other hand as ammo"
	quest.1D3CD000706C0C39.quest_desc: [
		"Hold the launcher, keep connectors in your other hand, and fire at an anchor point."
	]
	quest.13E92C3933678534.title: "Mounted Rope Launcher"
	quest.13E92C3933678534.quest_subtitle: "A rope launcher you can build onto a ship"
	quest.13E92C3933678534.quest_desc: [
		"Build it onto a ship and load it with connectors."
	]
	quest.1BB4787019AA68E6.title: "&6AeroClaims"
	quest.1BB4787019AA68E6.quest_subtitle: "Claim your build. Open the menu to activate the claim and check its owner"
	quest.1BB4787019AA68E6.quest_desc: [
		"Place the Claim Block on your build and open its menu to activate the claim."
	]
	quest.7C36AC287724FCA7.title: "&eOrnithopter Glider"
	quest.7C36AC287724FCA7.quest_subtitle: "A flapping-wing glider made with &eMechanical Crafting&r"
	quest.7C36AC287724FCA7.quest_desc: [
		"Craft wing mesh, then assemble the glider in a Mechanical Crafter."
		"Equip it and jump from somewhere high."
	]
	quest.3202B3169AC7D75E.title: "&dRoller Coasters"
	quest.3202B3169AC7D75E.quest_subtitle: "Connect two &6Track Anchorpoints&r with Coaster Track to make a smooth spline"
	quest.3202B3169AC7D75E.quest_desc: [
		"Use a &6Wrench&r to adjust the track path."
		"Add a chain lift by selecting a start and end with a Chain; the shaft at the start drives it."
	]
	quest.546E0DA597827983.title: "Rivets"
	quest.546E0DA597827983.quest_subtitle: "Place blocks at any angle or offset. Rotate in 15-degree steps while placing"
	quest.546E0DA597827983.quest_desc: [
		"Hold a rivet and press the rotate key while placing to set the angle."
	]
	quest.1602A6E3AB3C7525.title: "Launch Coaster"
	quest.1602A6E3AB3C7525.quest_subtitle: "Fit a Linear Motor to a track span, then program it with a controller"
	quest.1602A6E3AB3C7525.quest_desc: [
		"Steps: &eLaunch&r to a speed, &eTrim&r down, &eStop&r until redstone, or &eCoast&r through."
	]
	quest.10441FCC4B56B1AA.title: "Speed Readout"
	quest.10441FCC4B56B1AA.quest_subtitle: "Link a Coaster Observer to a display to show cart speed"
	quest.10441FCC4B56B1AA.quest_desc: [
		"Right-click a display, then the Coaster Observer, and pick what to show."
	]
	chapter.2FEAD1B31F2FE955.title: " &bAeronautics Addons"
	quest.159CDB4C3D9EC20C.title: "&aRaw Uranium"
	quest.159CDB4C3D9EC20C.quest_subtitle: "Mine uranium ore to start your way to nuclear power"
	quest.159CDB4C3D9EC20C.quest_desc: [
		"Uranium ore spawns underground. &cRaw uranium is radioactive&r: don't carry stacks around without protection."
	]
	quest.57473503FCD3E466.title: "Uranium Powder"
	quest.57473503FCD3E466.quest_subtitle: "&eCrush&r raw uranium. Can be fully automated"
	quest.57473503FCD3E466.quest_desc: [
		"Crush raw uranium in Crushing Wheels or a Millstone."
		"Next: yellowcake."
	]
	quest.40A4A7914E2394B8.title: "&7Lead"
	quest.40A4A7914E2394B8.quest_subtitle: "Mine lead ore and smelt it. Lead keeps the radiation in"
	quest.40A4A7914E2394B8.quest_desc: [
		"&cRadiation is real here.&r Craft the anti-radiation suit before you handle a lot of uranium."
	]
	quest.59B08375072097FB.title: "&eAnti-Radiation Suit"
	quest.59B08375072097FB.quest_subtitle: "Protects you from radiation. You can dye it any color"
	quest.59B08375072097FB.quest_desc: [
		"JEI shows the recipe for each piece. Wear the full set near uranium and the reactor."
	]
	quest.7D70EDF96835FDB9.title: "Reinforced Glass"
	quest.7D70EDF96835FDB9.quest_subtitle: "Strong glass for reactor windows"
	quest.7D70EDF96835FDB9.quest_desc: [
		"Craft it with lead. Use it where you want to see into the reactor."
	]
	quest.6F037EB3488A783E.title: "Coal Dust"
	quest.6F037EB3488A783E.quest_subtitle: "&eCrush&r coal or charcoal. A key ingredient for steel and graphene"
	quest.6F037EB3488A783E.quest_desc: [
		"Crush coal or charcoal."
		"Used for steel and graphene."
	]
	quest.64270596AD65C1E2.title: "&7Steel"
	quest.64270596AD65C1E2.quest_subtitle: "Combine coal dust and iron ingots"
	quest.64270596AD65C1E2.quest_desc: [
		"Combine coal dust and iron ingots (JEI shows the machine)."
	]
	quest.11754104B301F59E.title: "Graphene"
	quest.11754104B301F59E.quest_subtitle: "&ePress&r coal dust"
	quest.11754104B301F59E.quest_desc: [
		"Press coal dust with a Mechanical Press."
		"Next: graphite rods."
	]
	quest.5F8CBC3CA31E8AB1.title: "&eYellowcake"
	quest.5F8CBC3CA31E8AB1.quest_subtitle: "Blow it through a fan to &eenrich&r it and make it more powerful"
	quest.5F8CBC3CA31E8AB1.quest_desc: [
		"Make yellowcake from uranium powder, then blow it through a fan to enrich it."
	]
	quest.41CCB51DB9A9E9EA.title: "Enriching Campfire"
	quest.41CCB51DB9A9E9EA.quest_subtitle: "A campfire with a radioactive twist"
	quest.41CCB51DB9A9E9EA.quest_desc: [
		"Craft it with enriched materials. JEI shows what it is used for."
	]
	quest.4CEDC7DDF4C8FF1B.title: "Chemistry 101"
	quest.4CEDC7DDF4C8FF1B.quest_subtitle: "Mine nitrate ore or &ecrush&r limestone"
	quest.4CEDC7DDF4C8FF1B.quest_desc: [
		"Mine nitrate ore or crush limestone."
		"Next: smelt it into nitrogen concentrate."
	]
	quest.4A33B09D920E8014.title: "Nitrogen Concentrate"
	quest.4A33B09D920E8014.quest_subtitle: "Smelt nitrate in a &6Blast Furnace&r, then cool it down"
	quest.4A33B09D920E8014.quest_desc: [
		"Smelt nitrate in a Blast Furnace, then cool the concentrate."
	]
	quest.205A6546613934ED.title: "&bAbsolute Zero"
	quest.205A6546613934ED.quest_subtitle: "&eMix&r cooled nitrogen concentrate into &bliquid nitrogen&r, the reactor coolant"
	quest.205A6546613934ED.quest_desc: [
		"Mix cooled concentrate in a basin. Liquid nitrogen cools the reactor."
		"&bSwimming in it is not recommended.&r"
	]
	quest.694C01A21F8B0B65.title: "&aReactor Rods"
	quest.694C01A21F8B0B65.quest_subtitle: "Uranium rods heat the reactor, graphite rods slow it down"
	quest.694C01A21F8B0B65.quest_desc: [
		"Graphite rods: graphene and steel in a &6Mechanical Crafter&r."
		"Adjacent uranium rods boost each other's heat; graphite next to them lowers it."
	]
	quest.5E65865C791DC3EA.title: "Thorium"
	quest.5E65865C791DC3EA.quest_subtitle: "Mine thorium ore and &ecrush&r it into dust"
	quest.5E65865C791DC3EA.quest_desc: [
		"Thorium ore spawns underground. Crush raw thorium into dust."
	]
	quest.2E47C72CFFC89F4F.title: "&aThorium Rods"
	quest.2E47C72CFFC89F4F.quest_subtitle: "&eMix&r thorium dust into liquid, &ecompact&r it into ingots, then craft the strongest rod"
	quest.2E47C72CFFC89F4F.quest_desc: [
		"Mix dust into liquid thorium, compact it into ingots, then craft rods."
		"Thorium rods are the strongest heat source."
	]
	quest.14DBA6F6DFD13E92.title: "Reactor Shell"
	quest.14DBA6F6DFD13E92.quest_subtitle: "Casings and frames form the body of the reactor"
	quest.14DBA6F6DFD13E92.quest_desc: [
		"Craft casings and frames, then build the reactor walls. Bigger reactors need more."
	]
	quest.340A317C76DEE79A.title: "Reactor Parts"
	quest.340A317C76DEE79A.quest_subtitle: "The controller runs it, the core harnesses it, the cooler keeps it in check"
	quest.340A317C76DEE79A.quest_desc: [
		"The controller goes in the wall, the core in the middle, coolers around it. Ponder shows layouts."
	]
	quest.4E148D954DE3AF01.title: "Reactor Blueprint"
	quest.4E148D954DE3AF01.quest_subtitle: "Design the layout of rods inside your reactor"
	quest.4E148D954DE3AF01.quest_desc: [
		"Plan where uranium, graphite and thorium rods go before you load fuel. Ponder shows how the blueprint is used."
	]
	quest.55F858B3FBD8456E.title: "Inputs and Outputs"
	quest.55F858B3FBD8456E.quest_subtitle: "Feed in rods and liquid coolant, and take out the energy"
	quest.55F858B3FBD8456E.quest_desc: [
		"Rod Input feeds rods, Fluid Input feeds coolant, Output takes the energy."
	]
	quest.26E98AB955905859.title: "&cReactor Alarm"
	quest.26E98AB955905859.quest_subtitle: "Sounds when things heat up. Listen to it"
	quest.26E98AB955905859.quest_desc: [
		"Place it on the reactor. It sounds when heat gets dangerous."
	]
	quest.29C232FDC9C11FC3.title: "&aIt's Alive!"
	quest.29C232FDC9C11FC3.quest_subtitle: "Build and run a tier 1 nuclear reactor"
	quest.29C232FDC9C11FC3.quest_desc: [
		"Bigger reactors (5x5, 7x7, 9x9) have higher danger thresholds and make more power."
		"&cAlways be ready to stop the reactor before it overheats.&r Ponder shows how each part fits."
	]
	chapter.47924A464AF3CFE8.title: " &aCreate Nuclear"
	quest.14D0220D3DDCC38D.title: "&8The Factory Must Grow"
	quest.14D0220D3DDCC38D.quest_subtitle: "Heavy industry for Create: steel, oil, engines and real electricity"
	quest.14D0220D3DDCC38D.quest_desc: [
		"&e1.&r Coke ovens make coal coke."
		"&e2.&r A blast furnace turns iron and coke into &7steel&r."
		"&e3.&r Steel unlocks pumpjacks, the distillation tower, engines and generators."
		"Each section below is one part of the factory. Ponder explains every multiblock."
	]
	quest.10750B21BC4A1F1F.title: "New Ores"
	quest.10750B21BC4A1F1F.quest_subtitle: "Lead, nickel and lithium ore spawn underground. Smelt or crush them like other ores"
	quest.10750B21BC4A1F1F.quest_desc: [
		"Mine the new ores underground and smelt or crush them."
	]
	quest.2826D35CFB2243A0.title: "&fAluminum"
	quest.2826D35CFB2243A0.quest_subtitle: "Crush bauxite into powder, then refine it into aluminum in a &6Chemical Vat&r"
	quest.2826D35CFB2243A0.quest_desc: [
		"Aluminum goes into engines, spark plugs, turbines and the centrifuge."
	]
	quest.592B8DAC72A5362E.title: "Fireclay"
	quest.592B8DAC72A5362E.quest_subtitle: "Found in underground veins. Fired into fireproof bricks"
	quest.592B8DAC72A5362E.quest_desc: [
		"Find fireclay veins underground and fire the balls into bricks."
	]
	quest.6C758B2D244FED28.title: "Constantan"
	quest.6C758B2D244FED28.quest_subtitle: "&eMix&r copper and nickel. Used for heating wire and resistors"
	quest.6C758B2D244FED28.quest_desc: [
		"&eMix&r copper and nickel in a basin."
	]
	quest.4F8FF06FC5F13404.title: "&6Coke Ovens"
	quest.4F8FF06FC5F13404.quest_subtitle: "Slowly bakes coal into &6coal coke&r. Build long rows of them"
	quest.4F8FF06FC5F13404.quest_desc: [
		"Coal goes in anywhere. Carbon dioxide comes out the top; creosote can be pulled from any other side."
	]
	quest.7D94DB3F4C56570D.title: "Fireproof Bricks"
	quest.7D94DB3F4C56570D.quest_subtitle: "The walls of a blast furnace"
	quest.7D94DB3F4C56570D.quest_desc: [
		"Craft fireproof bricks from fireclay (found underground)."
		"Next: build the blast furnace walls."
	]
	quest.6DD02A9C15EA46D4.title: "Blast Stove"
	quest.6DD02A9C15EA46D4.quest_subtitle: "Turns fuel (bottom) and air (side) into &cHot Air&r (top)"
	quest.6DD02A9C15EA46D4.quest_desc: [
		"It slowly builds up carbon dioxide that stalls it. Build a smokestack or exhaust nearby."
	]
	quest.63CB7B77FCE6AD64.title: "Clear the Air"
	quest.63CB7B77FCE6AD64.quest_subtitle: "Smokestacks and exhausts get rid of the gases your machines make"
	quest.63CB7B77FCE6AD64.quest_desc: [
		"Place a smokestack or exhaust on top of machines that make gas, like the blast stove."
	]
	quest.49DC78F14CE8C549.title: "&6Blast Furnace"
	quest.49DC78F14CE8C549.quest_subtitle: "A cylinder of fireproof bricks around the output, with one hatch for hot air"
	quest.49DC78F14CE8C549.quest_desc: [
		"Reinforcements around it are required, and more of them make it faster."
		"Everything goes in through the hole at the top."
	]
	quest.59221451D8311D29.title: "&7Steel and Cast Iron"
	quest.59221451D8311D29.quest_subtitle: "The metals the whole factory is built from"
	quest.59221451D8311D29.quest_desc: [
		"Steel and cast iron come out of the blast furnace. Most TFMG machines need them."
	]
	quest.4E62A63642A8FB52.title: "Heavy Plates"
	quest.4E62A63642A8FB52.quest_subtitle: "&ePress&r steel three times in Sequenced Assembly"
	quest.4E62A63642A8FB52.quest_desc: [
		"Sequenced Assembly: press a steel ingot three times."
	]
	quest.22C3DF36A6AF7807.title: "Steel Mechanism"
	quest.22C3DF36A6AF7807.quest_subtitle: "TFMG's precision mechanism. Built on a heavy plate in Sequenced Assembly"
	quest.22C3DF36A6AF7807.quest_desc: [
		"Sequenced Assembly on a heavy plate, like a precision mechanism."
	]
	quest.4601FAB2D4691A9C.title: "Surface Scanner"
	quest.4601FAB2D4691A9C.quest_subtitle: "Helps find chunks with oil underground"
	quest.4601FAB2D4691A9C.quest_desc: [
		"Walk around with it to find chunks that have oil underground, then build the pumpjack there."
	]
	quest.7131F7EEDFE79A57.title: "&8Pumpjack"
	quest.7131F7EEDFE79A57.quest_subtitle: "Pumps crude oil out of oil chunks"
	quest.7131F7EEDFE79A57.quest_desc: [
		"Build it on an oil chunk found with the Surface Scanner. Power it with rotation."
	]
	quest.1E883D1C2C1B6606.title: "Crude Oil"
	quest.1E883D1C2C1B6606.quest_subtitle: "Raw oil, ready to refine"
	quest.1E883D1C2C1B6606.quest_desc: [
		"Pump it from the pumpjack into tanks."
		"Next: refine it in a distillation tower."
	]
	quest.501FC86D82CCAD12.title: "&6Distillation Tower"
	quest.501FC86D82CCAD12.quest_subtitle: "Splits crude oil into fuels and chemicals"
	quest.501FC86D82CCAD12.quest_desc: [
		"Steel fluid tanks form the base. Place the controller next to them, then up to 6 outputs with industrial pipes between."
		"A heat source under the tanks powers it. Oil goes into the controller."
	]
	quest.73AA660BE062D51A.title: "Fuels"
	quest.73AA660BE062D51A.quest_subtitle: "Diesel, gasoline, kerosene, LPG, naphtha and heavy oil all have their uses"
	quest.73AA660BE062D51A.quest_desc: [
		"Each output of the tower gives a different fuel. Engines and generators burn them."
	]
	quest.6D42FB46A7BE3D82.title: "Flarestack"
	quest.6D42FB46A7BE3D82.quest_subtitle: "Burns oil products you don't need"
	quest.6D42FB46A7BE3D82.quest_desc: [
		"Pipe unwanted fluids into it to burn them off."
	]
	quest.41E115E5DB8FDA34.title: "Plastic"
	quest.41E115E5DB8FDA34.quest_subtitle: "Cast from molten plastic. Used in pipes, electronics and Chemica"
	quest.41E115E5DB8FDA34.quest_desc: [
		"Made from refined oil products. JEI shows the process."
	]
	quest.65F0F0835991B914.title: "Asphalt"
	quest.65F0F0835991B914.quest_subtitle: "Paved roads from oil by-products"
	quest.65F0F0835991B914.quest_desc: [
		"Mix asphalt from oil by-products and place it for roads."
	]
	quest.2B5F447A0076B9C0.title: "&cEngines"
	quest.2B5F447A0076B9C0.quest_subtitle: "Burn fuel for serious rotational power"
	quest.2B5F447A0076B9C0.quest_desc: [
		"Engines need cylinders, spark plugs and fuel. Ponder shows how to build each one."
	]
	quest.2A086C35DEC79A22.title: "Spark Plugs"
	quest.2A086C35DEC79A22.quest_subtitle: "Spark plugs (aluminum and flint) go into engine cylinders"
	quest.2A086C35DEC79A22.quest_desc: [
		"Craft spark plugs in a Mechanical Crafter, then add them to engine cylinders."
	]
	quest.336440CD10209FA5.title: "&cLarge Engine"
	quest.336440CD10209FA5.quest_subtitle: "Creates rotation from less refined fuels. Built in a Mechanical Crafter"
	quest.336440CD10209FA5.quest_desc: [
		"Build it in a Mechanical Crafter and feed it fuel."
	]
	quest.232C3B8BCB50E39A.title: "Turbos \\& Intakes"
	quest.232C3B8BCB50E39A.quest_subtitle: "Feed engines more air for more power"
	quest.232C3B8BCB50E39A.quest_desc: [
		"Attach a turbo or air intake to your engine."
	]
	quest.4391E481FFBDB88B.title: "Oil Can"
	quest.4391E481FFBDB88B.quest_subtitle: "Adds lubrication oil to engines"
	quest.4391E481FFBDB88B.quest_desc: [
		"Use it on engines to keep them lubricated."
	]
	quest.224752829F981797.title: "&eElectricity"
	quest.224752829F981797.quest_subtitle: "Generators make &evoltage&r and &epower&r; devices draw current based on their resistance"
	quest.224752829F981797.quest_desc: [
		"Components share a network group (group 0 by default). Change groups with the Configuration Wrench."
	]
	quest.2ED5C9CA04FF74B0.title: "Winding Machine"
	quest.2ED5C9CA04FF74B0.quest_subtitle: "Winds copper spools into coils, the core of motors and generators"
	quest.2ED5C9CA04FF74B0.quest_desc: [
		"Feed it copper spools and an unfinished coil."
	]
	quest.540AEC3C894B7E11.title: "Electric Motor"
	quest.540AEC3C894B7E11.quest_subtitle: "Turns electricity back into rotation"
	quest.540AEC3C894B7E11.quest_desc: [
		"Connect it to your electric network. It turns power back into rotation."
	]
	quest.79280CF6FAD72B1E.title: "Measure It"
	quest.79280CF6FAD72B1E.quest_subtitle: "Read the voltage, current and power of any electric block"
	quest.79280CF6FAD72B1E.quest_desc: [
		"Right-click an electric block to read its voltage, current and power."
	]
	quest.32E86E1A7FB17505.title: "Subnetworks"
	quest.32E86E1A7FB17505.quest_subtitle: "A diode passes power one way; a potentiometer sets how much voltage gets through; a switch uses redstone"
	quest.32E86E1A7FB17505.quest_desc: [
		"Place a diode, potentiometer or switch between two parts of your network."
	]
	quest.24F3BC4171A3FBF2.title: "Storage and Transformers"
	quest.24F3BC4171A3FBF2.quest_subtitle: "Accumulators store power; transformers change voltage by their coil ratio"
	quest.24F3BC4171A3FBF2.quest_desc: [
		"Accumulators store energy (in from the bottom, out from the top). Transformers change voltage."
	]
	quest.2B4E878E87977398.title: "Magnets"
	quest.2B4E878E87977398.quest_subtitle: "Mix nickel, silicon and steel into magnetic alloy, then polarize it. Lightning might do something too..."
	quest.2B4E878E87977398.quest_desc: [
		"Polarize magnetic alloy ingots into magnets. Used in generators and motors."
	]
	quest.4F53D9209A059145.title: "Electric Lights"
	quest.4F53D9209A059145.quest_subtitle: "Bulbs, neon tubes and light panels run on your network"
	quest.4F53D9209A059145.quest_desc: [
		"Connect a light to a powered network."
	]
	quest.550626388F07CADE.title: "&dChemical Vat"
	quest.550626388F07CADE.quest_subtitle: "A vat whose attachments decide what it does"
	quest.550626388F07CADE.quest_desc: [
		"Industrial mixer + mixer blade: a mixer (or a centrifuge)."
		"2 electrode holders with copper electrodes: an electrolyzer."
		"3 graphite electrodes: an electric blast furnace."
	]
	quest.53833183D7F819BF.title: "Electrolysis"
	quest.53833183D7F819BF.quest_subtitle: "Two electrode holders with copper electrodes turn the vat into an electrolyzer"
	quest.53833183D7F819BF.quest_desc: [
		"Place two electrode holders with copper electrodes on the vat. Power it to split fluids."
	]
	quest.6D8ADE00EC788EE4.title: "Sulfuric Acid"
	quest.6D8ADE00EC788EE4.quest_subtitle: "Sulfur, saltpeter and water in the vat make sulfuric acid, used to etch circuit boards"
	quest.6D8ADE00EC788EE4.quest_desc: [
		"Put sulfur dust, saltpeter and water into the Chemical Vat."
	]
	quest.168BEEC4C4FDDBC1.title: "Circuit Boards"
	quest.168BEEC4C4FDDBC1.quest_subtitle: "Etch a coated board in sulfuric acid, then finish it in Sequenced Assembly"
	quest.168BEEC4C4FDDBC1.quest_desc: [
		"Coat a board, etch it in sulfuric acid, then finish it with Deployers."
	]
	quest.4A2B89076F2F9119.title: "Electronics"
	quest.4A2B89076F2F9119.quest_subtitle: "Transistors, capacitors and resistors for advanced machines"
	quest.4A2B89076F2F9119.quest_desc: [
		"Each part is made in Sequenced Assembly. JEI shows the steps."
	]
	quest.43F6D53DAD25175B.title: "Rebar Concrete"
	quest.43F6D53DAD25175B.quest_subtitle: "Pump concrete into rebar with a hose. It sets as rebar concrete"
	quest.43F6D53DAD25175B.quest_desc: [
		"Place rebar where you want concrete, then pump liquid concrete through the hose."
	]
	quest.2E58C49AC7250B82.title: "Cement"
	quest.2E58C49AC7250B82.quest_subtitle: "&eMix&r clay and limesand"
	quest.2E58C49AC7250B82.quest_desc: [
		"Mix clay and limesand in a basin."
	]
	quest.6C10A9FC01AEDCE1.title: "&cFlamethrower"
	quest.6C10A9FC01AEDCE1.quest_subtitle: "Burns gases and fuels to shoot bursts of flame"
	quest.6C10A9FC01AEDCE1.quest_desc: [
		"Build it in a Mechanical Crafter and fill it with a burnable fluid."
	]
	quest.78784A749E1A629E.title: "Lithium Blade"
	quest.78784A749E1A629E.quest_subtitle: "Lithium charges set the blade on fire and let it shoot hellfire bolts"
	quest.78784A749E1A629E.quest_desc: [
		"Craft the blade, then load it with lithium charges."
	]
	quest.158710D66D036871.title: "Boom"
	quest.158710D66D036871.quest_subtitle: "Grenades and napalm potatoes. Load potatoes into the Advanced Potato Cannon"
	quest.158710D66D036871.quest_desc: [
		"Craft grenades from metal and powder. Napalm potatoes fire from the Advanced Potato Cannon."
	]
	chapter.1949416C1A5DDBB0.title: " &8The Factory Must Grow"
	quest.6107EB0ADF6579E5.title: "&dReal-World Chemistry"
	quest.6107EB0ADF6579E5.quest_subtitle: "Chemica adds real chemistry on top of TFMG. Most of it runs in the &6Chemical Vat&r"
	quest.6107EB0ADF6579E5.quest_desc: [
		"Finish TFMG's steel, distillation and Chemical Vat first."
		"The path: new ores, then catalysts, then polymers and circuits, then carbon fiber and tough alloys."
		"Use JEI on any Chemica item to follow its process chain."
	]
	quest.218B6E5B78F4C0D9.title: "New Ores"
	quest.218B6E5B78F4C0D9.quest_subtitle: "Platinum, cobalt, chromite, molybdenum, antimony and more spawn underground"
	quest.218B6E5B78F4C0D9.quest_desc: [
		"Mine the new ores and process them like other Create ores."
		"JEI shows each one."
	]
	quest.4D67F37FB65B9514.title: "Platinum"
	quest.4D67F37FB65B9514.quest_subtitle: "Smelt raw platinum. Used for the best catalyst and platinum electrodes"
	quest.4D67F37FB65B9514.quest_desc: [
		"Mine platinum ore and smelt it."
	]
	quest.3F68807B93258168.title: "Base Metals"
	quest.3F68807B93258168.quest_subtitle: "Smelt or crush the new ores into ingots"
	quest.3F68807B93258168.quest_desc: [
		"Smelt the raw ores, or crush them first for extra output."
	]
	quest.2F65D9A26489DB6F.title: "Graphite"
	quest.2F65D9A26489DB6F.quest_subtitle: "Purify graphite flakes, then mix them with sucrose solution into graphite"
	quest.2F65D9A26489DB6F.quest_desc: [
		"Purify graphite flakes, then mix them with sucrose solution in a basin."
	]
	quest.6DB1AA64D7AE15E1.title: "Rutile"
	quest.6DB1AA64D7AE15E1.quest_subtitle: "Higher-grade rutile crystals lead to titanium"
	quest.6DB1AA64D7AE15E1.quest_desc: [
		"Process rutile in the Chemical Vat to raise its grade (JEI shows each step)."
	]
	quest.7E258BF789ECC022.title: "&fTitanium"
	quest.7E258BF789ECC022.quest_subtitle: "Cast from molten titanium. A key part of lightweight alloys"
	quest.7E258BF789ECC022.quest_desc: [
		"Melt high-grade rutile into molten titanium and cast it."
	]
	quest.2A8DF85A9B8FB6EE.title: "Labware"
	quest.2A8DF85A9B8FB6EE.quest_subtitle: "&eCut&r glass into vials, cylinders and petri dishes"
	quest.2A8DF85A9B8FB6EE.quest_desc: [
		"&eCut&r glass with a Mechanical Saw."
	]
	quest.39D739C24F0BD7C9.title: "&dCatalysts"
	quest.39D739C24F0BD7C9.quest_subtitle: "Catalysts unlock many reactions. The Iron Catalyst mixes iron dust, silver and sodium"
	quest.39D739C24F0BD7C9.quest_desc: [
		"&eMix&r the catalyst ingredients in a basin. JEI shows each one."
	]
	quest.1BBCDD93EFD30BF3.title: "Platinum Catalyst"
	quest.1BBCDD93EFD30BF3.quest_subtitle: "&eMix&r platinum dust, iron nugget and coal dust"
	quest.1BBCDD93EFD30BF3.quest_desc: [
		"Mix platinum dust, an iron nugget and coal dust."
	]
	quest.21B11A8A1169FFA2.title: "Graphene"
	quest.21B11A8A1169FFA2.quest_subtitle: "Purified graphite with water and oxygen in the Chemical Vat"
	quest.21B11A8A1169FFA2.quest_desc: [
		"Put purified graphite flakes in the Chemical Vat with water and oxygen."
	]
	quest.45056024A172F661.title: "&dPolymers"
	quest.45056024A172F661.quest_subtitle: "PE, PVC, PTFE, nylon and epoxy, mostly cast from fluids made in the vat"
	quest.45056024A172F661.quest_desc: [
		"Made from oil products and chemicals in the Chemical Vat. Follow JEI from each sheet."
	]
	quest.2663F625B443B3BF.title: "PTFE"
	quest.2663F625B443B3BF.quest_subtitle: "Fluorine, sulfuric acid, oxygen and ammonium persulfate in the vat"
	quest.2663F625B443B3BF.quest_desc: [
		"Run fluorine, sulfuric acid, oxygen and ammonium persulfate through the Chemical Vat."
	]
	quest.557B7DD441640AA9.title: "Nylon"
	quest.557B7DD441640AA9.quest_subtitle: "Make nylon salt, melt it and cast nylon"
	quest.557B7DD441640AA9.quest_desc: [
		"Make nylon salt in the vat, then melt and cast it."
	]
	quest.3B070734D5ECE40B.title: "Conductive Paste"
	quest.3B070734D5ECE40B.quest_subtitle: "Cut, press and fill polyethylene in Sequenced Assembly"
	quest.3B070734D5ECE40B.quest_desc: [
		"Sequenced Assembly: cut, press and fill a polyethylene sheet."
	]
	quest.43DDF224DB158410.title: "Electronic Circuits"
	quest.43DDF224DB158410.quest_subtitle: "Etch a PVC board in sulfuric acid, then finish it in Sequenced Assembly"
	quest.43DDF224DB158410.quest_desc: [
		"Coat, etch and fill circuit boards. JEI shows each step."
	]
	quest.352607F94C417CED.title: "&dAdvanced Circuits"
	quest.352607F94C417CED.quest_subtitle: "The epoxy version of the circuit: the best electronics Chemica can make"
	quest.352607F94C417CED.quest_desc: [
		"Upgrade electronic circuits with better boards and parts."
	]
	quest.6E701B54CA3A9AFF.title: "PAN Fibers"
	quest.6E701B54CA3A9AFF.quest_subtitle: "Compact PAN precursor into fibers, then stabilize them"
	quest.6E701B54CA3A9AFF.quest_desc: [
		"Compact PAN precursor fluid into fibers, then stabilize them."
	]
	quest.619869C9E9CA99E4.title: "Carbon Fiber"
	quest.619869C9E9CA99E4.quest_subtitle: "Compact stabilized fibers under argon into strands, then mix them with epoxy resin into sheets"
	quest.619869C9E9CA99E4.quest_desc: [
		"Spin PAN fibers into carbon fiber, then press it into sheets."
	]
	quest.5B7A8D207BEC53AD.title: "Lightweight Alloy"
	quest.5B7A8D207BEC53AD.quest_subtitle: "Aluminum, titanium and magnesium"
	quest.5B7A8D207BEC53AD.quest_desc: [
		"&eMix&r aluminum, titanium and magnesium ingots."
	]
	quest.3C69DF94A372C124.title: "Heat-Resistant Alloy"
	quest.3C69DF94A372C124.quest_subtitle: "Netherite, tungsten and iridium"
	quest.3C69DF94A372C124.quest_desc: [
		"&eMix&r a netherite ingot with tungsten and iridium."
	]
	quest.655296D2CF383BFF.title: "&dAdvanced Composite Alloy"
	quest.655296D2CF383BFF.quest_subtitle: "Vanadium, carbon fiber sheet and aluminum: the top of Chemica's material chain"
	quest.655296D2CF383BFF.quest_desc: [
		"Alloy the new metals with carbon fiber. The top tier of Chemica."
	]
	quest.1B70913E2CFFF599.title: "Better Engine Cylinders"
	quest.1B70913E2CFFF599.quest_subtitle: "Engine cylinders for biodiesel, ethanol and high-octane or high-cetane fuels"
	quest.1B70913E2CFFF599.quest_desc: [
		"Each cylinder lets an engine burn a different Chemica fuel. JEI shows the recipes."
	]
	chapter.127C29BECBF5A3E2.title: " &dChemica"
	quest.21291F5BE8BD1914.title: "Dirty Dusts"
	quest.21291F5BE8BD1914.quest_subtitle: "Metallurgy ore processing starts by breaking ores into dirty dusts"
	quest.21291F5BE8BD1914.quest_desc: [
		"Crush raw ores to get dirty dusts. Washing and melting them gives more metal than smelting."
	]
	quest.1D37E00E6BD05989.title: "Washed Dusts"
	quest.1D37E00E6BD05989.quest_subtitle: "&eWash&r dirty dusts with a fan through water. Clean dusts melt into more metal"
	quest.1D37E00E6BD05989.quest_desc: [
		"Run dirty dusts through a fan blowing through water."
		"Next: melt them in the foundry."
	]
	quest.5A36972DAC0C380D.title: "&6Foundry"
	quest.5A36972DAC0C380D.quest_subtitle: "A basin that melts metals. Put a &6Foundry Lid&r on top and heat it"
	quest.5A36972DAC0C380D.quest_desc: [
		"It holds 9 items of one type."
		"Close the lid or the recipe won't start."
	]
	quest.102710C036D148C4.title: "Faucet"
	quest.102710C036D148C4.quest_subtitle: "Pours fluid straight down, up to 5 blocks"
	quest.102710C036D148C4.quest_desc: [
		"Put it on the side of a foundry basin. It pours molten metal down into casting blocks."
	]
	quest.38572F9EE244D98A.title: "Casting"
	quest.38572F9EE244D98A.quest_subtitle: "Cool molten metal into shapes"
	quest.38572F9EE244D98A.quest_desc: [
		"The &6Casting Basin&r casts whole blocks."
		"The &6Casting Table&r casts items using Graphite Molds."
	]
	quest.153E6D069E454068.title: "Graphite"
	quest.153E6D069E454068.quest_subtitle: "The material for molds"
	quest.153E6D069E454068.quest_desc: [
		"Craft graphite (JEI shows how). It is used for molds."
	]
	quest.39C4EBD28442F939.title: "Graphite Molds"
	quest.39C4EBD28442F939.quest_subtitle: "Lock a mold in place with the lock slot so funnels don't pull it out"
	quest.39C4EBD28442F939.quest_desc: [
		"Put a mold on a Casting Table. Lock it so funnels don't take it."
	]
	quest.24A2721EC83DB70A.title: "Coke"
	quest.24A2721EC83DB70A.quest_subtitle: "&eBlast&r coal into coke"
	quest.24A2721EC83DB70A.quest_desc: [
		"Blast coal in a furnace or with a fan through lava."
	]
	quest.74A6D6FE2CE446BF.title: "Foundry Mixer"
	quest.74A6D6FE2CE446BF.quest_subtitle: "Mixes molten metals together into alloys"
	quest.74A6D6FE2CE446BF.quest_desc: [
		"Put the mixer over a foundry to combine molten metals."
	]
	quest.278E76A0C6256D70.title: "&7Steel Age"
	quest.278E76A0C6256D70.quest_subtitle: "Alloy iron and coke"
	quest.278E76A0C6256D70.quest_desc: [
		"Mix molten iron with coke in the foundry mixer."
	]
	quest.3733E8C72C91CF0C.title: "&6Industrial Crucible"
	quest.3733E8C72C91CF0C.quest_subtitle: "A much bigger foundry that melts big items and many at once"
	quest.3733E8C72C91CF0C.quest_desc: [
		"A &e5x5&r base reaches max temperature. Each base block without a burner under it cools it down."
		"Check the heat with Goggles. It also does alloying and entity melting."
	]
	quest.309A50A0385FACEE.title: "Gauges"
	quest.309A50A0385FACEE.quest_subtitle: "Add or remove attachments with a Wrench"
	quest.309A50A0385FACEE.quest_desc: [
		"Attach gauges to a crucible with a wrench to read its heat."
	]
	quest.210F3A4AA8A79650.title: "&8Tungsten Age"
	quest.210F3A4AA8A79650.quest_subtitle: "Turn raw wolframite from wolframite ore into tungsten"
	quest.210F3A4AA8A79650.quest_desc: [
		"Mine wolframite ore and process it into tungsten (JEI shows the steps)."
	]
	quest.699EB62CAB771B65.title: "Tungsten Parts"
	quest.699EB62CAB771B65.quest_subtitle: "Wire and sheets for high-end builds"
	quest.699EB62CAB771B65.quest_desc: [
		"Cast or roll tungsten into wire, spools and sheets (JEI)."
	]
	quest.7BD274911F7D79E8.title: "Light Bulbs"
	quest.7BD274911F7D79E8.quest_subtitle: "Glow brighter the stronger the redstone signal. Bulbs can work as a network"
	quest.7BD274911F7D79E8.quest_desc: [
		"Place it and power it with redstone. Brightness follows signal strength."
	]
	quest.1BA2C3A09C21852D.title: "Belt Grinder"
	quest.1BA2C3A09C21852D.quest_subtitle: "Uses rotation to sand down anything on top of it. Even you, so watch your step"
	quest.1BA2C3A09C21852D.quest_desc: [
		"Power it with rotation and put a sandpaper belt on it. It sands items placed on top."
	]
	quest.68804B14FB26C79D.title: "Obdurium"
	quest.68804B14FB26C79D.quest_subtitle: "A tough late-game metal. Check JEI for how it is made"
	quest.68804B14FB26C79D.quest_desc: [
		"A late-game metal from the crucible. JEI shows the recipe."
	]
	chapter.5EA262AC46B7380A.title: " &6Create: Metallurgy"
	quest.2AF0CE75A76ADD58.title: "&6Backpack"
	quest.2AF0CE75A76ADD58.quest_subtitle: "Extra inventory you can wear. &eShift-right-click&r to place it, open it with a keybind"
	quest.2AF0CE75A76ADD58.quest_desc: [
		"Craft a backpack. Sneak-right-click to place it, use the backpack key to open it while wearing it."
	]
	quest.46A3E59E29C0FA25.title: "Bigger Backpacks"
	quest.46A3E59E29C0FA25.quest_subtitle: "Upgrade through iron, gold, diamond and netherite for more slots and upgrade space"
	quest.46A3E59E29C0FA25.quest_desc: [
		"Combine a backpack with metal ingots to upgrade it in place. It keeps its items."
	]
	quest.7566C26F7A6FAE2A.title: "Backpack Upgrades"
	quest.7566C26F7A6FAE2A.quest_subtitle: "Every upgrade starts from an Upgrade Base"
	quest.7566C26F7A6FAE2A.quest_desc: [
		"Craft an Upgrade Base, then turn it into any upgrade (JEI)."
		"Put upgrades in the backpack's upgrade slots."
	]
	quest.77C282784F9CB83E.title: "Pickup \\& Magnet"
	quest.77C282784F9CB83E.quest_subtitle: "Pull items straight into your backpack"
	quest.77C282784F9CB83E.quest_desc: [
		"Pickup grabs items you walk over, Magnet pulls them from a distance."
	]
	quest.443661805397240B.title: "Handy Upgrades"
	quest.443661805397240B.quest_subtitle: "Craft on the go, eat automatically, refill your hotbar or swap to the right tool"
	quest.443661805397240B.quest_desc: [
		"Crafting adds a crafting grid, Feeding eats for you, Refill and Tool Swapper keep your hotbar ready."
	]
	quest.38E8D84CDDB63F92.title: "Stack Upgrade"
	quest.38E8D84CDDB63F92.quest_subtitle: "Each slot holds more than a normal stack"
	quest.38E8D84CDDB63F92.quest_desc: [
		"Put it in the upgrade slot. Higher tiers fit even more."
	]
	quest.7C48AC6DF60EFC85.title: "&6Sophisticated Storage"
	quest.7C48AC6DF60EFC85.quest_subtitle: "Chests and barrels that take upgrades just like backpacks"
	quest.7C48AC6DF60EFC85.quest_desc: [
		"Craft a barrel or chest from wood. They take the same upgrades as backpacks."
	]
	quest.4508854F9063CCD9.title: "Tier Upgrades"
	quest.4508854F9063CCD9.quest_subtitle: "Upgrade a placed chest or barrel in place, without emptying it"
	quest.4508854F9063CCD9.quest_desc: [
		"Right-click a placed chest or barrel with the tier upgrade."
	]
	quest.790E9984708E8833.title: "Limited Barrels"
	quest.790E9984708E8833.quest_subtitle: "Drawer-style barrels that hold lots of one item"
	quest.790E9984708E8833.quest_desc: [
		"Each slot holds a lot of one item. Good for bulk storage."
	]
	quest.190212168D08D74A.title: "Storage Stack Upgrade"
	quest.190212168D08D74A.quest_subtitle: "More items per slot in your storage"
	quest.190212168D08D74A.quest_desc: [
		"Put it in a storage block's upgrade slot."
	]
	quest.6E6B9DC685B2FBD9.title: "&6Storage Controller"
	quest.6E6B9DC685B2FBD9.quest_subtitle: "Connect your chests and barrels into one network you can search from a single block"
	quest.6E6B9DC685B2FBD9.quest_desc: [
		"Place the controller touching your storage, or link distant storage with Storage Links."
		"Open it to search everything."
	]
	quest.57FE60CEED092D92.title: "Packing Tape"
	quest.57FE60CEED092D92.quest_subtitle: "Tape up a full chest or barrel so you can move it without spilling anything"
	quest.57FE60CEED092D92.quest_desc: [
		"Use it on a full chest or barrel, then break it. It keeps all its items."
	]
	quest.70FB89B3BD62CA55.title: "Storage Tool"
	quest.70FB89B3BD62CA55.quest_subtitle: "Configure and link storage blocks quickly"
	quest.70FB89B3BD62CA55.quest_desc: [
		"Use it to link storage to a controller and change settings."
	]
	quest.77D5ABDF2CB3D162.title: "Storage Labels"
	quest.77D5ABDF2CB3D162.quest_subtitle: "Put a label on storage so you always know what's inside"
	quest.77D5ABDF2CB3D162.quest_desc: [
		"Right-click storage with a label to show what's inside."
	]
	quest.2DF0243FCA8DA187.title: "&fCreature Comforts"
	quest.2DF0243FCA8DA187.quest_subtitle: "A sleeping bag for camping trips, a hammock for an afternoon nap"
	quest.2DF0243FCA8DA187.quest_desc: [
		"A sleeping bag skips the night without setting your spawn. A hammock skips the day."
	]
	quest.23334AE341F10619.title: "Rope and Nail"
	quest.23334AE341F10619.quest_subtitle: "Hang a hammock between two walls"
	quest.23334AE341F10619.quest_desc: [
		"Place rope and nail on two walls, then hang a hammock between them."
	]
	chapter.6BE1BA3E4F3F27B6.title: " &eStorage &7\\& &fComfort"
	quest.23D34C74E8DDCCEF.title: "&eBees, Bees, Bees"
	quest.23D34C74E8DDCCEF.quest_subtitle: "Bees that make iron, gems, slime and more. Here is where to start"
	quest.23D34C74E8DDCCEF.quest_desc: [
		"&e1.&r Find a vanilla bee nest for honey and honeycomb."
		"&e2.&r Craft &6Bee Cages&r (they need honey bottles)."
		"&e3.&r Build an &6Advanced Beehive&r and an &6Expansion Box&r."
		"&e4.&r Catch new bees from hidden nests, then breed resource bees."
		"The &6Productive Bees guide book&r covers every bee."
	]
	quest.377DD7EDE1C9DB80.title: "&6Bee Cage"
	quest.377DD7EDE1C9DB80.quest_subtitle: "&eRight-click&r a bee to catch it, right-click the ground to release it"
	quest.377DD7EDE1C9DB80.quest_desc: [
		"Always carry a few cages when exploring. A &6Sturdy Bee Cage&r can be reused."
	]
	quest.65D6BDFE1858450B.title: "Solitary Nests"
	quest.65D6BDFE1858450B.quest_subtitle: "Each nest hides one solitary bee. Break it to take the nest with the bee inside, no silk touch needed"
	quest.65D6BDFE1858450B.quest_desc: [
		"Different nests attract different bees: stone, sand, wood and more. Match the nest to the bee you want."
	]
	quest.30F19F33356CE716.title: "Nest Locator"
	quest.30F19F33356CE716.quest_subtitle: "&eSneak-right-click&r a nest (or a block like sand) to set it, then right-click to find that nest type"
	quest.30F19F33356CE716.quest_desc: [
		"Point it at a nest type, then follow it to the nearest nest of that kind."
	]
	quest.3360220BD3D9DA6C.title: "&6Honey Treats"
	quest.3360220BD3D9DA6C.quest_subtitle: "Calm angry bees, grow babies faster, and lure new bees into empty nests"
	quest.3360220BD3D9DA6C.quest_desc: [
		"Right-click an empty nest with a treat to start its repopulation timer."
	]
	quest.1A4809199FD6F9B7.title: "Slimy Bees"
	quest.1A4809199FD6F9B7.quest_subtitle: "Slimy nests hide in swampy biomes"
	quest.1A4809199FD6F9B7.quest_desc: [
		"Search swamps with the Nest Locator set to a slimy nest."
	]
	quest.3A863B431D35CEBE.title: "&cBees of the Nether"
	quest.3A863B431D35CEBE.quest_subtitle: "Quartz nests hold &fCrystalline Bees&r, the key parent for iron and gold"
	quest.3A863B431D35CEBE.quest_desc: [
		"Also look for Glowing (glowstone), Ghostly (soul sand) and Magmatic (nether fortress brick) nests."
	]
	quest.30B4FCFE063F813E.title: "More Nether Nests"
	quest.30B4FCFE063F813E.quest_subtitle: "Glowing, Ghostly and Magmatic Bees, each with their own preferred flowers"
	quest.30B4FCFE063F813E.quest_desc: [
		"Bring cages to the Nether and catch each new bee type."
	]
	quest.5594E6C400C27ACD.title: "&dEnder Bees"
	quest.5594E6C400C27ACD.quest_subtitle: "End stone nests on the outer End islands. They pollinate chorus plants"
	quest.5594E6C400C27ACD.quest_desc: [
		"Fly out past the End's main island and search the outer islands."
	]
	quest.76F700D4DB260678.title: "Sugarbag Bee"
	quest.76F700D4DB260678.quest_subtitle: "A tropical bee that makes an extra delicious comb"
	quest.76F700D4DB260678.quest_desc: [
		"Look in jungles and other warm, wet biomes."
	]
	quest.74741B82723AB57B.title: "JourBee"
	quest.74741B82723AB57B.quest_subtitle: "Steer a &6Bumble Bee&r with a Treat on a Stick. It's not the destination..."
	quest.74741B82723AB57B.quest_desc: [
		"Catch a Bumble Bee, saddle up and steer it with the treat."
	]
	quest.5C32C8A6BCC66D00.title: "&6Advanced Beehive"
	quest.5C32C8A6BCC66D00.quest_subtitle: "Look inside to watch your bees. No campfire needed, and it can be moved with bees inside"
	quest.5C32C8A6BCC66D00.quest_desc: [
		"There is an Advanced Beehive for most wood types."
	]
	quest.442A88DF5DE4D181.title: "Expansion Box"
	quest.442A88DF5DE4D181.quest_subtitle: "Raises a hive from &e3 to 5 bees&r. Place it on top of or next to the hive (one per hive)"
	quest.442A88DF5DE4D181.quest_desc: [
		"Place it on top of or beside your Advanced Beehive."
	]
	quest.2D98D759829951EA.title: "Honeycombs"
	quest.2D98D759829951EA.quest_subtitle: "Each bee type makes its own resource comb. Compress combs into comb blocks for storage"
	quest.2D98D759829951EA.quest_desc: [
		"Bees in Advanced Beehives drop combs into the hive. Take them out by hand or with a hopper."
	]
	quest.7CA049D2D52AE51C.title: "Feeding Slab"
	quest.7CA049D2D52AE51C.quest_subtitle: "Holds 3 flower blocks as a shared feeding spot"
	quest.7CA049D2D52AE51C.quest_desc: [
		"Lumber and Quarry bees feeding here produce from a random block in it."
		"Pour honey on it (honeylogged) to give bees Regeneration."
	]
	quest.2765A1613CB2D075.title: "Bee Nest Helmet"
	quest.2765A1613CB2D075.quest_subtitle: "Bees stop attacking you, and the nest's bees may defend you"
	quest.2765A1613CB2D075.quest_desc: [
		"Craft it from a diamond helmet and a bee nest. Wear it around your hives."
	]
	quest.6B4A216CC9290638.title: "Bee Jar"
	quest.6B4A216CC9290638.quest_subtitle: "Display a caged bee. Insert the cage with a hopper or pipe"
	quest.6B4A216CC9290638.quest_desc: [
		"Fill it with a caged bee using a hopper or pipe."
	]
	quest.6B6570C59F9A51CB.title: "Night Shift"
	quest.6B6570C59F9A51CB.quest_subtitle: "Leash a bee outside at night and it may become Nocturnal. Leash a nocturnal bee by day for Metaturnal (works all day)"
	quest.6B6570C59F9A51CB.quest_desc: [
		"Weather tolerance works the same way: leave bees leashed out in rain. Keep honey treats ready, they can take damage while adapting."
	]
	quest.3D723ACE42430878.title: "&6Centrifuge"
	quest.3D723ACE42430878.quest_subtitle: "Spins combs into resources and honey. Holds 10 buckets of fluid"
	quest.3D723ACE42430878.quest_desc: [
		"It pushes fluid into any tank placed next to it. It also splits bottled bee material into genes."
	]
	quest.47498CF279FA1490.title: "Waxing Up"
	quest.47498CF279FA1490.quest_subtitle: "Wax goes into hives, cages and upgrades"
	quest.47498CF279FA1490.quest_desc: [
		"Wax comes out of the centrifuge along with honey and resources."
	]
	quest.5C4F75685BF9F1F6.title: "Bottler"
	quest.5C4F75685BF9F1F6.quest_subtitle: "Bottles honey and other fluids. Put it next to a centrifuge to fill automatically"
	quest.5C4F75685BF9F1F6.quest_desc: [
		"Place it next to a centrifuge, or pump honey into its side, with empty bottles inside."
	]
	quest.77C2FD81B642782C.title: "Powered Centrifuge"
	quest.77C2FD81B642782C.quest_subtitle: "Runs on FE and processes much faster"
	quest.77C2FD81B642782C.quest_desc: [
		"Power it with FE from a Honey Generator or any other source."
	]
	quest.7C8C2CAA2A77E9A4.title: "Honey Generator"
	quest.7C8C2CAA2A77E9A4.quest_subtitle: "Burns honey into FE. Productivity upgrades use less honey, Speed upgrades make more power"
	quest.7C8C2CAA2A77E9A4.quest_desc: [
		"Pipe honey in, or put honey bottles, blocks or buckets in its GUI."
	]
	quest.39336BC79E57B3B5.title: "&dBreeding Chamber"
	quest.39336BC79E57B3B5.quest_subtitle: "Load two parent bees, their breeding items, power and empty cages"
	quest.39336BC79E57B3B5.quest_desc: [
		"Speed upgrades make it faster. You can also breed bees by hand with their breeding items."
	]
	quest.553DD210C3C19EB5.title: "BaBee Incubator"
	quest.553DD210C3C19EB5.quest_subtitle: "Put a caged baby bee in with honey treats to grow it up fast"
	quest.553DD210C3C19EB5.quest_desc: [
		"Put a caged baby bee in with honey treats."
	]
	quest.1FA5C0915B37B4E7.title: "Catcher"
	quest.1FA5C0915B37B4E7.quest_subtitle: "Load it with cages and it catches bees flying over it. Put a flower on top to attract them"
	quest.1FA5C0915B37B4E7.quest_desc: [
		"Load it with empty cages and place a flower or feeding slab on top."
	]
	quest.2912EBE8B5E7626D.title: "&fIron Bee"
	quest.2912EBE8B5E7626D.quest_subtitle: "Crystalline Bee + Ashy Mining Bee"
	quest.2912EBE8B5E7626D.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.72266FDFB2F40352.title: "&6Gold Bee"
	quest.72266FDFB2F40352.quest_subtitle: "Crystalline Bee + Mason Bee"
	quest.72266FDFB2F40352.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.33DAE8A437084A8A.title: "&cRedstone Bee"
	quest.33DAE8A437084A8A.quest_subtitle: "Glowing Bee + Chocolate Mining Bee"
	quest.33DAE8A437084A8A.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.554475959A49F9BC.title: "&9Lapis Bee"
	quest.554475959A49F9BC.quest_subtitle: "Redstone Bee + Blue Banded Bee"
	quest.554475959A49F9BC.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.51F8790DD8B887D9.title: "&bDiamond Bee"
	quest.51F8790DD8B887D9.quest_subtitle: "Ender Bee + Lapis Bee"
	quest.51F8790DD8B887D9.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.190B092B0301C6F2.title: "&aEmerald Bee"
	quest.190B092B0301C6F2.quest_subtitle: "Slimy Bee + Diamond Bee"
	quest.190B092B0301C6F2.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.7525FE6E8192D6C9.title: "&8Ancient Bee"
	quest.7525FE6E8192D6C9.quest_subtitle: "Feed a Diamond Bee a block of netherite"
	quest.7525FE6E8192D6C9.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.51B7F8402FE8D594.title: "CreeBee"
	quest.51B7F8402FE8D594.quest_subtitle: "Feed a block of TNT to a vanilla bee"
	quest.51B7F8402FE8D594.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.6239C90AF4C261E8.title: "Skeletal Bee \\& ZomBee"
	quest.6239C90AF4C261E8.quest_subtitle: "They move into an empty advanced hive left in the dark"
	quest.6239C90AF4C261E8.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.65388AB6E1F8AF1B.title: "Prismarine Bee"
	quest.65388AB6E1F8AF1B.quest_subtitle: "Caught by fishing in an ocean biome"
	quest.65388AB6E1F8AF1B.quest_desc: [
		"Tick the box once you have it. JEI shows every breeding pair: look up the bee or its comb."
	]
	quest.42C8BBC8C094CED6.title: "&aWorker Bees"
	quest.42C8BBC8C094CED6.quest_subtitle: "Bees that do jobs for you instead of making resources"
	quest.42C8BBC8C094CED6.quest_desc: [
		"&6Farmer&r harvests crops in a 4-block radius (Range upgrades help)."
		"&6Rancher&r milks cows and shears sheep for milky combs."
		"&6Collector&r and &6Hoarder&r pick up dropped items. Pair them with a Farmer for an automatic farm."
	]
	quest.7EA3027E222D1791.title: "Quarry Bee"
	quest.7EA3027E222D1791.quest_subtitle: "Nibbles stone, sand or gravel into stone chips. Craft chips back into blocks"
	quest.7EA3027E222D1791.quest_desc: [
		"Give a Quarry Bee a hive near stone, sand or gravel."
	]
	quest.7FE3263A88253BA6.title: "Lumber Bee"
	quest.7FE3263A88253BA6.quest_subtitle: "Nibbles nearby wood into wood chips"
	quest.7FE3263A88253BA6.quest_desc: [
		"Give a Lumber Bee a hive near trees."
	]
	quest.5CADE398E070191D.title: "Bottling a Bee"
	quest.5CADE398E070191D.quest_subtitle: "Bottler + piston: put the bee in the middle and pull the lever (keep empty bottles in the bottler)"
	quest.5CADE398E070191D.quest_desc: [
		"Place a Bottler with a piston pointing at it. Put the bee in the middle and pull the lever."
	]
	quest.418BAA5F8E0E1C75.title: "Gene Samples"
	quest.418BAA5F8E0E1C75.quest_subtitle: "Centrifuge the bottled bee to separate its genes"
	quest.418BAA5F8E0E1C75.quest_desc: [
		"Put the bottled bee material into a centrifuge."
	]
	quest.412583672798CC1D.title: "&dGenetics"
	quest.412583672798CC1D.quest_subtitle: "Put a gene on a honey treat and feed it to a bee to pass the trait on"
	quest.412583672798CC1D.quest_desc: [
		"Purity sets the chance it works. Combine two of the same gene to raise purity."
		"The &6Gene Indexer&r (needs redstone) combines genes for you."
	]
	quest.7033D031B8AD2339.title: "&bUpgrades"
	quest.7033D031B8AD2339.quest_subtitle: "Upgrades go into hives and machines"
	quest.7033D031B8AD2339.quest_desc: [
		"Craft an Upgrade Base, then turn it into the upgrade you want (JEI shows each)."
	]
	quest.22442C083EC179AB.title: "Productivity"
	quest.22442C083EC179AB.quest_subtitle: "More combs per trip. Four tiers, Alpha to Omega"
	quest.22442C083EC179AB.quest_desc: [
		"Put it in an Advanced Beehive. Higher tiers stack up more combs."
	]
	quest.57122DC8E1BD63D4.title: "Speed"
	quest.57122DC8E1BD63D4.quest_subtitle: "Bees work faster"
	quest.57122DC8E1BD63D4.quest_desc: [
		"Put it in a hive or machine to make it work faster."
	]
	quest.3429F0BCD07ADE58.title: "Simulator"
	quest.3429F0BCD07ADE58.quest_subtitle: "Bees stay inside the hive. Much better for performance"
	quest.3429F0BCD07ADE58.quest_desc: [
		"Put it in an Advanced Beehive to keep bees inside. Great for big farms."
	]
	quest.407FBE2C390D057C.title: "Range, BaBee \\& Filter"
	quest.407FBE2C390D057C.quest_subtitle: "Range for workers and catchers, BaBee for natural breeding in a hive, Filter to pick which bees"
	quest.407FBE2C390D057C.quest_desc: [
		"Range widens a worker bee's area, BaBee breeds new bees in the hive, Filter picks which bees a catcher takes."
	]
	quest.37619BF6A47D69B4.title: "&5Draconic Bees"
	quest.37619BF6A47D69B4.quest_subtitle: "They live in obsidian pillars on the End's main island. A Dragon Egg Hive lets you harvest draconic combs"
	quest.37619BF6A47D69B4.quest_desc: [
		"Wake an Inactive Dragon Egg with Dragon Breath, then hollow it out into a Dragon Egg Hive."
	]
	chapter.7AAE8A8FD9D47C6C.title: " &eProductive Bees"
	quest.6EE161CDE9AB1111.title: "&6Industrial Beekeeping"
	quest.6EE161CDE9AB1111.quest_subtitle: "Modular Bees turns Productive Bees into big, fast, low-lag multiblocks"
	quest.6EE161CDE9AB1111.quest_desc: [
		"Finish the &eProductive Bees&r basics first. You'll need an Advanced Beehive and some upgrades."
	]
	quest.54E97286C99E5C98.title: "&6Modular Beehive"
	quest.54E97286C99E5C98.quest_subtitle: "The controller of a &e3x3x3&r beehive multiblock"
	quest.54E97286C99E5C98.quest_desc: [
		"Fill the rest of the cube with &6Beehive Structure Boxes&r, then swap boxes for functional parts."
		"It has a built-in Simulator: bees never leave, and they don't breed or transform inside."
		"Parts can't be shared between two hives."
	]
	quest.6087A1DCF5904DFE.title: "Structure Boxes"
	quest.6087A1DCF5904DFE.quest_subtitle: "The frame of the hive. Any box can be replaced with a functional part"
	quest.6087A1DCF5904DFE.quest_desc: [
		"Craft enough boxes to fill the 3x3x3 cube around the core."
	]
	quest.1A66AE7D962E63BE.title: "Alveary"
	quest.1A66AE7D962E63BE.quest_subtitle: "The core can't hold bees. Each Alveary holds &e5 bees&r"
	quest.1A66AE7D962E63BE.quest_desc: [
		"&eRight-click&r an Alveary with a bee cage to put a bee in or take it out."
	]
	quest.3B86E195EF4EB4AD.title: "Modular Feeder"
	quest.3B86E195EF4EB4AD.quest_subtitle: "Bees only look for flowers here. Holds 9 flower types, plus buckets or tanks for fluid flowers"
	quest.3B86E195EF4EB4AD.quest_desc: [
		"Swap one box for the feeder and put flowers in it."
	]
	quest.49BF6ED619E56F24.title: "Export Hatch"
	quest.49BF6ED619E56F24.quest_subtitle: "Pulls combs out of the hive for your logistics"
	quest.49BF6ED619E56F24.quest_desc: [
		"Swap a box for the hatch and pull combs out with pipes or funnels."
	]
	quest.6830C5754496CB50.title: "Beehive Treater"
	quest.6830C5754496CB50.quest_subtitle: "Feeds bees extra food for more combs. JEI lists valid foods and their boosts"
	quest.6830C5754496CB50.quest_desc: [
		"Every bee needs food; the boost drops if there isn't enough to go around."
	]
	quest.2F0A4E8B974F0BFA.title: "&cOverclocker"
	quest.2F0A4E8B974F0BFA.quest_subtitle: "Uses power and an &6Electrode&r to make bees work faster"
	quest.2F0A4E8B974F0BFA.quest_desc: [
		"Boosts from several overclockers add up."
		"Two Netherite Electrodes make bees work about &e9x&r faster."
	]
	quest.624A0F4076DC91A1.title: "Better Electrodes"
	quest.624A0F4076DC91A1.quest_subtitle: "Four tiers of electrodes. Check the tooltip for each boost"
	quest.624A0F4076DC91A1.quest_desc: [
		"Better electrodes give bigger speed boosts. Check the tooltip on each."
	]
	quest.2FE5470FAD9F7C35.title: "Beehive Stacker"
	quest.2FE5470FAD9F7C35.quest_subtitle: "Another way to squeeze more out of every hive. See the guide book"
	quest.2FE5470FAD9F7C35.quest_desc: [
		"Swap a box for the stacker. The guide book explains what it does."
	]
	quest.3623AD0A9ABCEB6E.title: "&5Modular Dragon Hive"
	quest.3623AD0A9ABCEB6E.quest_subtitle: "A special hive that collects Dragon Breath from draconic bees"
	quest.3623AD0A9ABCEB6E.quest_desc: [
		"A special core for draconic bees. Fill it like a normal Modular Beehive."
	]
	quest.521A1F5B59448BAA.title: "&6Modular Centrifuge"
	quest.521A1F5B59448BAA.quest_subtitle: "A &e3x3x3&r centrifuge multiblock that runs many combs in parallel"
	quest.521A1F5B59448BAA.quest_desc: [
		"Build it from &6Centrifuge Structure Walls&r and swap walls for functional parts."
		"It takes every centrifuge upgrade: speed shortens each job, productivity runs more at once."
	]
	quest.55A7B8DCD24DA828.title: "Centrifuge Walls"
	quest.55A7B8DCD24DA828.quest_subtitle: "The frame of the centrifuge"
	quest.55A7B8DCD24DA828.quest_desc: [
		"Craft enough walls to build the centrifuge multiblock."
	]
	quest.764A3CAF41705034.title: "Import \\& Export"
	quest.764A3CAF41705034.quest_subtitle: "Hatches to feed combs in and pull products out"
	quest.764A3CAF41705034.quest_desc: [
		"Swap walls for import and export hatches, then connect your logistics."
	]
	quest.6454930D1801CE8B.title: "Centrifuge Parts"
	quest.6454930D1801CE8B.quest_subtitle: "Gearbox, Heater and Overclocker parts change how the centrifuge runs. See the guide book"
	quest.6454930D1801CE8B.quest_desc: [
		"Swap walls for these parts to change speed and heat. The guide book has details."
	]
	quest.1E98C4B3E4937BAD.title: "Bee Extractor"
	quest.1E98C4B3E4937BAD.quest_subtitle: "Made from a Productive Bees Bottler. Check JEI for what it does with your bees"
	quest.1E98C4B3E4937BAD.quest_desc: [
		"Check JEI and the Modular Bees guide for how it works with your bees."
	]
	chapter.2A855CC7E9B761C4.title: " &6Modular Bees"
	quest.43DBB8B767D00D27.title: "&6Kitchen Knife"
	quest.43DBB8B767D00D27.quest_subtitle: "Kaleidoscope Cookery brings real cooking: knives, woks, stockpots and dozens of dishes"
	quest.43DBB8B767D00D27.quest_desc: [
		"Craft an iron kitchen knife. You'll use it for cutting ingredients and getting oil."
	]
	quest.27C2B07345F503EC.title: "Chopping Board"
	quest.27C2B07345F503EC.quest_subtitle: "Use your knife on the board to prepare new ingredients"
	quest.27C2B07345F503EC.quest_desc: [
		"Place a chopping board, put an ingredient on it, and use the knife on it."
	]
	quest.248D9DE0B3FF348A.title: "Cooking Oil"
	quest.248D9DE0B3FF348A.quest_subtitle: "Kill pigs, piglins or hoglins with a kitchen knife to get oil"
	quest.248D9DE0B3FF348A.quest_desc: [
		"Kill pigs, piglins or hoglins with the kitchen knife."
	]
	quest.67DB60CD946ADC82.title: "Stove"
	quest.67DB60CD946ADC82.quest_subtitle: "Light it up and start cooking"
	quest.67DB60CD946ADC82.quest_desc: [
		"Place it and light it. Woks and stockpots go on top."
	]
	quest.325FAFA7D023AFF2.title: "&6Stir-Fry"
	quest.325FAFA7D023AFF2.quest_subtitle: "Place a wok over a heat source, add oil, then your ingredients"
	quest.325FAFA7D023AFF2.quest_desc: [
		"&eStir-fry&r with a kitchen shovel until it's cooked, then serve with a bowl."
		"Don't grab the wrong ingredient out of a hot wok..."
	]
	quest.6FFC8ED3C24B0CF8.title: "&6Stockpot"
	quest.6FFC8ED3C24B0CF8.quest_subtitle: "Add a broth first, then ingredients, then cover with the lid"
	quest.6FFC8ED3C24B0CF8.quest_desc: [
		"Lift the lid when the soup is ready and serve with a bowl."
	]
	quest.799EC478A8A07D8B.title: "Apprentice Chef"
	quest.799EC478A8A07D8B.quest_subtitle: "Cook a bowl of borscht"
	quest.799EC478A8A07D8B.quest_desc: [
		"Make it in the stockpot. JEI shows the ingredients."
	]
	quest.2BC78DC9C27A23EE.title: "More Kitchenware"
	quest.2BC78DC9C27A23EE.quest_subtitle: "Steamers, millstones and a shawarma spit, each with its own recipes in JEI"
	quest.2BC78DC9C27A23EE.quest_desc: [
		"Each tool has its own recipes. Look them up in JEI."
	]
	quest.5B01C8878A223ECA.title: "Rice Paddies"
	quest.5B01C8878A223ECA.quest_subtitle: "Hoe farmland underwater for a paddy field. Fish in the field make rice grow faster"
	quest.5B01C8878A223ECA.quest_desc: [
		"Hoe farmland underwater to make a paddy, then plant rice. Fish in the water speed it up."
	]
	quest.67BB3345CD68522E.title: "&6Master Chef"
	quest.67BB3345CD68522E.quest_subtitle: "Braised Beef on Rice: a proper meal"
	quest.67BB3345CD68522E.quest_desc: [
		"Cook braised beef in the stockpot and serve it over rice."
	]
	quest.3E41D98CFB4B0302.title: "&6Create: Ratatouille"
	quest.3E41D98CFB4B0302.quest_subtitle: "Automated food factories. The Oven is heated by a Blaze Burner and needs Oven Fans for air"
	quest.3E41D98CFB4B0302.quest_desc: [
		"Put a Blaze Burner under the Oven and Oven Fans around it."
		"It bakes in bulk for your food lines."
	]
	quest.59563BE22A815D24.title: "Thresher"
	quest.59563BE22A815D24.quest_subtitle: "Processes crops for your food lines"
	quest.59563BE22A815D24.quest_desc: [
		"Power it with rotation and feed it crops."
	]
	quest.5723F7EE695C02B8.title: "Irrigation Tower"
	quest.5723F7EE695C02B8.quest_subtitle: "Keeps farmland moist. Fill it with compost tea to slowly turn farmland into rich soil"
	quest.5723F7EE695C02B8.quest_desc: [
		"Fill it with water (or compost tea) and place it in your fields."
	]
	quest.46434C96CE65B33C.title: "Compost Tea"
	quest.46434C96CE65B33C.quest_subtitle: "A plant ripening agent. Each bottle works three times"
	quest.46434C96CE65B33C.quest_desc: [
		"Make compost tea in the compost tower and use it on crops."
	]
	quest.4B713FC1EB11CA77.title: "Spreader"
	quest.4B713FC1EB11CA77.quest_subtitle: "Spreads ripen matter to fertilize plants, or mature matter to ready animals for breeding"
	quest.4B713FC1EB11CA77.quest_desc: [
		"Load it with ripen matter for crops or mature matter for animals."
	]
	quest.22910CECB2E118B3.title: "Sausage Factory"
	quest.22910CECB2E118B3.quest_subtitle: "Mince meat, fill casings, and cook. Fully automatable"
	quest.22910CECB2E118B3.quest_desc: [
		"Mince meat into casings, then cook them. JEI shows each step."
	]
	quest.36545C8D7632CFF0.title: "Chef Hat"
	quest.36545C8D7632CFF0.quest_subtitle: "Look the part. There's even a version with goggles"
	quest.36545C8D7632CFF0.quest_desc: [
		"Craft it. There's also a version with goggles built in."
	]
	quest.159AB46AE4279F5F.title: "&aOverweight Crops"
	quest.159AB46AE4279F5F.quest_subtitle: "Sometimes crops grow into giant blocks. Harvest one!"
	quest.159AB46AE4279F5F.quest_desc: [
		"Grow carrots, potatoes, beets or other crops. Sometimes they grow into a giant block."
	]
	quest.4D837017BAB6A943.title: "Overweight Golden Apple"
	quest.4D837017BAB6A943.quest_subtitle: "The rarest overweight crop of all"
	quest.4D837017BAB6A943.quest_desc: [
		"Very rare. JEI shows which crop it grows from."
	]
	quest.1EABFF3BD71ABDE5.title: "&eBeach Party"
	quest.1EABFF3BD71ABDE5.quest_subtitle: "Kick back on the beach"
	quest.1EABFF3BD71ABDE5.quest_desc: [
		"Craft beach furniture from the Beachparty tab in JEI."
	]
	quest.14440E03C546758F.title: "Cocktails"
	quest.14440E03C546758F.quest_subtitle: "Mix up a drink at the palm bar"
	quest.14440E03C546758F.quest_desc: [
		"Mix cocktails at the palm bar. JEI shows each recipe."
	]
	quest.38A2EB0A33BB572F.title: "Mini Fridge"
	quest.38A2EB0A33BB572F.quest_subtitle: "Keep your drinks cool"
	quest.38A2EB0A33BB572F.quest_desc: [
		"Craft it and store your drinks in it."
	]
	chapter.7CD79BECD400764D.title: " &6World Kitchen"
	quest.7EFAC13C0485C0D1.title: "&dTreasure Hunting"
	quest.7EFAC13C0485C0D1.quest_subtitle: "Dungeons, ruins and chests hide magical gear you can't craft"
	quest.7EFAC13C0485C0D1.quest_desc: [
		"Explore structures and open loot chests. Every find here makes your character stronger."
	]
	quest.28736DC9BC382DF0.title: "&dYour First Relic"
	quest.28736DC9BC382DF0.quest_subtitle: "Relics are found in loot chests. Each one has abilities that level up as you use it"
	quest.28736DC9BC382DF0.quest_desc: [
		"Hover a relic to see its abilities. Some abilities are used with the relic ability key."
	]
	quest.7E50D38AEC50CC14.title: "Relic Experience"
	quest.7E50D38AEC50CC14.quest_subtitle: "Levels up a relic's abilities faster"
	quest.7E50D38AEC50CC14.quest_desc: [
		"Use it on a relic to give it experience."
	]
	quest.26D298054E623889.title: "Collector"
	quest.26D298054E623889.quest_subtitle: "Find three relics. Wear several at once in your accessory slots"
	quest.26D298054E623889.quest_desc: [
		"Keep exploring structures. Wear relics in your accessory slots."
	]
	quest.4A4AAF946C8405CE.title: "&bMagic Mirror"
	quest.4A4AAF946C8405CE.quest_subtitle: "One of the most useful relics there is. Keep looking!"
	quest.4A4AAF946C8405CE.quest_desc: [
		"Found in loot chests. Use it to teleport home."
	]
	quest.2E1DEC9FC674C337.title: "&5Arcane Abilities"
	quest.2E1DEC9FC674C337.quest_subtitle: "An addon with new items, skills and a dungeon. The Skills Grimoire is where it starts"
	quest.2E1DEC9FC674C337.quest_desc: [
		"Look for the Arcane Abilities dungeon and its loot."
	]
	quest.1C0379DC27308CA9.title: "&6Artifacts"
	quest.1C0379DC27308CA9.quest_subtitle: "Trinkets from chests, each with a passive effect. Wear them in accessory slots"
	quest.1C0379DC27308CA9.quest_desc: [
		"Artifacts come from chests, mimics and some mobs."
	]
	quest.1BBF51D246D459C2.title: "&cChest Slayer"
	quest.1BBF51D246D459C2.quest_subtitle: "Some chests bite back. Kill a &6Mimic&r: they drop artifacts"
	quest.1BBF51D246D459C2.quest_desc: [
		"A chest that attacks when opened. Defeat it for an artifact."
	]
	quest.1510BBDCD56B987A.title: "Curio Cabinet"
	quest.1510BBDCD56B987A.quest_subtitle: "Collect five different artifacts"
	quest.1510BBDCD56B987A.quest_desc: [
		"Keep looting. Each artifact gives a different passive."
	]
	quest.572B5A1AE683B8B2.title: "Adventurous Eater"
	quest.572B5A1AE683B8B2.quest_subtitle: "Yes, some artifacts are edible. Forever"
	quest.572B5A1AE683B8B2.quest_desc: [
		"Everlasting Beef and Eternal Steak never run out."
	]
	quest.6F8A50AC2CCA7966.title: "&5Reliquary"
	quest.6F8A50AC2CCA7966.quest_subtitle: "Mob drops become magic items, potions and tools"
	quest.6F8A50AC2CCA7966.quest_desc: [
		"Many Reliquary items need rare mob parts like &6Zombie Hearts&r, &6Rib Bones&r and &6Catalyzing Glands&r."
	]
	quest.6A19AFDA06D228F9.title: "Monster Parts"
	quest.6A19AFDA06D228F9.quest_subtitle: "Hunt mobs for their rare drops"
	quest.6A19AFDA06D228F9.quest_desc: [
		"Each part comes from a specific mob. JEI shows which mob drops what."
	]
	quest.56082B9D37863398.title: "Alkahestry"
	quest.56082B9D37863398.quest_subtitle: "The Tome of Alkahestry turns redstone into copies of common items"
	quest.56082B9D37863398.quest_desc: [
		"Charge the tome with redstone, then craft it with an item to duplicate it."
	]
	quest.46ECBC68EB046941.title: "Staffs and Rods"
	quest.46ECBC68EB046941.quest_subtitle: "Powerful magic tools made from monster parts"
	quest.46ECBC68EB046941.quest_desc: [
		"Each staff and rod needs specific mob parts. JEI shows the recipes."
	]
	quest.526F62CFF8B4482C.title: "Hunter's Handgun"
	quest.526F62CFF8B4482C.quest_subtitle: "Assembled from a barrel, grip and hammer. Shoots magazines of special bullets"
	quest.526F62CFF8B4482C.quest_desc: [
		"Craft the barrel, grip and hammer, then assemble. Load magazines."
	]
	quest.754DF61E2031663D.title: "&6Phoenix Down"
	quest.754DF61E2031663D.quest_subtitle: "Saves you from death. Worth every monster part"
	quest.754DF61E2031663D.quest_desc: [
		"Keep it in your inventory. It saves you once from dying."
	]
	quest.27503FCA82653687.title: "&6Iron's Arms 'n Artifice"
	quest.27503FCA82653687.quest_subtitle: "First we arm, then we artifice. Blackpowder and mechanical parts power your first guns"
	quest.27503FCA82653687.quest_desc: [
		"Make blackpowder and simple mechanical parts."
		"Next: your first gun."
	]
	quest.37E95EED1CA024C8.title: "Flintlock"
	quest.37E95EED1CA024C8.quest_subtitle: "Load bullets and fire your first gun"
	quest.37E95EED1CA024C8.quest_desc: [
		"Craft a flintlock and bullets. Right-click to fire."
	]
	quest.17EA788DCEAE4BA9.title: "Gun Modifiers"
	quest.17EA788DCEAE4BA9.quest_subtitle: "Install modifiers on a gun to change how it shoots. Fill every slot for a fully loaded gun"
	quest.17EA788DCEAE4BA9.quest_desc: [
		"Combine a gun with a modifier to install it. Each gun has a few slots."
	]
	quest.7521910EE5719D62.title: "The Arsenal"
	quest.7521910EE5719D62.quest_subtitle: "Muskets, blunderbusses and revolvers. There are seven guns in total"
	quest.7521910EE5719D62.quest_desc: [
		"Each gun plays differently. JEI shows all seven."
	]
	quest.63BCCF4587AF5A43.title: "&6Tick Tock"
	quest.63BCCF4587AF5A43.quest_subtitle: "The Clockwork Rifle, one of the best guns in the mod"
	quest.63BCCF4587AF5A43.quest_desc: [
		"Needs clockwork components. A fast, accurate rifle."
	]
	quest.6AB73F745DA07D66.title: "Gunslinger Hats"
	quest.6AB73F745DA07D66.quest_subtitle: "The Cowboy Hat and Tricorne give your shooting a little extra"
	quest.6AB73F745DA07D66.quest_desc: [
		"Wear them for shooting bonuses."
	]
	chapter.339A8B404A357A40.title: " &dRelics, Artifacts &7\\& &6Arms"
	quest.3B286A2EDF02A87D.title: "&2The Witching World"
	quest.3B286A2EDF02A87D.quest_subtitle: "Herbs, cauldrons, candles, brooms and familiars. Start here"
	quest.3B286A2EDF02A87D.quest_desc: [
		"Hexerei is a slow, cozy magic mod. The usual path is:"
		"&e1.&r gather herbs from swamps and jungles"
		"&e2.&r build a &6Mixing Cauldron&r"
		"&e3.&r dry herbs on a &6Drying Rack&r"
		"&e4.&r craft broom brushes and your first &6Broom&r."
		"The &6Book of Shadows&r on an altar explains every item in detail."
	]
	quest.22FDBBD35DD48545.title: "Dowsing Rod"
	quest.22FDBBD35DD48545.quest_subtitle: "Points you to the &aswamps&r and &ajungles&r where witch herbs grow"
	quest.22FDBBD35DD48545.quest_desc: [
		"&eSneak-right-click&r to switch between Swamps and Jungles, &eright-click&r to search for a new biome of that type."
	]
	quest.10E054ED6297A270.title: "&2Witch's Herbs"
	quest.10E054ED6297A270.quest_subtitle: "Mandrake, Belladonna, Mugwort and Yellow Dock grow in swamps and jungles"
	quest.10E054ED6297A270.quest_desc: [
		"Harvest a fully grown plant by &eright-clicking&r it, like a sweet berry bush."
		"Mandrake also drops &6Mandrake Root&r and Mugwort drops &6Mugwort Leaves&r; both are used in broom brushes."
		"&cBelladonna berries are poisonous.&r"
	]
	quest.71D2C72707A62B6E.title: "Roots and Leaves"
	quest.71D2C72707A62B6E.quest_subtitle: "Mandrake Root builds brooms and brushes; Mugwort Leaves make the basic brush"
	quest.71D2C72707A62B6E.quest_desc: [
		"Right-click fully grown mandrake and mugwort plants."
	]
	quest.3CB1A19DC8142B54.title: "Sage Seeds"
	quest.3CB1A19DC8142B54.quest_subtitle: "Break grass to find Sage Seeds, then plant them on farmland"
	quest.3CB1A19DC8142B54.quest_desc: [
		"Break tall grass until you find sage seeds."
	]
	quest.68C0729B066A0EE7.title: "Sage Harvest"
	quest.68C0729B066A0EE7.quest_subtitle: "Sage cleanses an area of evil spirits once it is bundled and dried"
	quest.68C0729B066A0EE7.quest_desc: [
		"Plant the seeds on farmland and harvest when grown."
	]
	quest.4400A3DFD1C93093.title: "Witch Woods"
	quest.4400A3DFD1C93093.quest_subtitle: "Willow, Witch Hazel and Mahogany logs. Each wood makes a different broom"
	quest.4400A3DFD1C93093.quest_desc: [
		"Willow grows in swamps; use a Dowsing Rod to find witch biomes."
	]
	quest.35807B6FC4C5900E.title: "Animal Fat"
	quest.35807B6FC4C5900E.quest_subtitle: "Dropped by cows, pigs and sheep (Looting helps). Used for tallow and the Book of Shadows"
	quest.35807B6FC4C5900E.quest_desc: [
		"Kill cows, pigs or sheep."
	]
	quest.79AF31F2C27F34BE.title: "&2Mixing Cauldron"
	quest.79AF31F2C27F34BE.quest_subtitle: "The heart of a witch's workshop"
	quest.79AF31F2C27F34BE.quest_desc: [
		"Throw items in from the top, pipe them in, or use its GUI. Click the middle of the GUI to see every recipe in JEI."
		"It holds up to &e2 buckets&r of fluid. Some recipes need &cheat&r under it: fire, lava, a campfire or magma."
		"The top-left slot holds &6Sigils&r."
	]
	quest.3A38C238BE8FD2A2.title: "&5Book of Shadows"
	quest.3A38C238BE8FD2A2.quest_subtitle: "Hexerei's full guide. Place it on an &6Altar&r to read and turn the pages"
	quest.3A38C238BE8FD2A2.quest_desc: [
		"Bookmark pages from the top-left corner. Hover an item in the book and press the recipe key to jump to JEI."
		"&eSneak-right-click&r the altar to pick the book back up."
	]
	quest.4E92DE08F9D99B07.title: "Drying Rack"
	quest.4E92DE08F9D99B07.quest_subtitle: "Hang herbs and wet brushes here to dry them"
	quest.4E92DE08F9D99B07.quest_desc: [
		"3 slots, up to 3 items each. &eRight-click&r to add, right-click again to take out finished items."
		"Hoppers and pipes can automate it."
	]
	quest.7FEFB32527A6D60C.title: "Pestle and Mortar"
	quest.7FEFB32527A6D60C.quest_subtitle: "Grinds herbs into blends, pastes and crow snacks. Made in a heated cauldron"
	quest.7FEFB32527A6D60C.quest_desc: [
		"&eRight-click&r to add one item, &esneak-right-click&r to add a whole stack. Take the result out with a right-click when it finishes."
	]
	quest.1A6AC5E60FB92122.title: "Wet Broom Brush"
	quest.1A6AC5E60FB92122.quest_subtitle: "Brushes are made wet in the cauldron first, then dried"
	quest.1A6AC5E60FB92122.quest_desc: [
		"Make it in the Mixing Cauldron (JEI shows the ingredients)."
	]
	quest.7F4CDC2BB810D563.title: "Broom Brush"
	quest.7F4CDC2BB810D563.quest_subtitle: "Dry the wet brush on a rack. The brush is what makes a broom fly"
	quest.7F4CDC2BB810D563.quest_desc: [
		"Brushes wear out while flying and break eventually. Mending and Unbreaking work on them."
	]
	quest.772A109C3EAA419B.title: "&2Fly a Broom"
	quest.772A109C3EAA419B.quest_subtitle: "Willow is slowest and cheapest, Witch Hazel is in between, Mahogany is fastest (needs netherite)"
	quest.772A109C3EAA419B.quest_desc: [
		"Every new broom comes with a brush. &eSneak-right-click&r a placed broom to open its slots: &eMisc&r, &eSatchel&r and &eBrush&r."
		"Carry spare brushes for long trips."
	]
	quest.217EFC945E8CE1E8.title: "Enhanced Brush"
	quest.217EFC945E8CE1E8.quest_subtitle: "Made with the four witch flowers. Lasts twice as long"
	quest.217EFC945E8CE1E8.quest_desc: [
		"Make a wet enhanced brush in the cauldron, then dry it on a rack."
	]
	quest.6429DE7D36989F59.title: "Moon Dust Brush"
	quest.6429DE7D36989F59.quest_subtitle: "Faster, especially under a full moon"
	quest.6429DE7D36989F59.quest_desc: [
		"Make a wet moon dust brush in the cauldron, then dry it."
	]
	quest.123855EB973313EA.title: "Satchels"
	quest.123855EB973313EA.quest_subtitle: "Small, Medium and Large add 9, 18 and 27 slots. Replacer swaps in a spare brush; Ender opens your ender chest"
	quest.123855EB973313EA.quest_desc: [
		"Craft satchels in the cauldron and put them in the broom's Satchel slot."
	]
	quest.18AAF256CD71B68B.title: "Broom Attachments"
	quest.18AAF256CD71B68B.quest_subtitle: "Netherite Tip flies through lava and fire; Waterproof Tip keeps you seated underwater"
	quest.18AAF256CD71B68B.quest_desc: [
		"Craft attachments in the cauldron and put them in the broom's Misc slot."
	]
	quest.4B9196FCF9FADF06.title: "Broom Whistle"
	quest.4B9196FCF9FADF06.quest_subtitle: "Bind it to your broom and blow it to call the broom to you"
	quest.4B9196FCF9FADF06.quest_desc: [
		"Craft it and bind it to your broom."
	]
	quest.2E012505314422C9.title: "Blood Sigil"
	quest.2E012505314422C9.quest_subtitle: "Put it in the cauldron's sigil slot. Jump in three times to fill a bottle of blood"
	quest.2E012505314422C9.quest_desc: [
		"Blood is a key ingredient for brooms. Drinking it gives Absorption."
	]
	quest.78932BE062527B22.title: "Dipper"
	quest.78932BE062527B22.quest_subtitle: "&eSneak-right-click&r it onto the cauldron to dip items into the fluid below"
	quest.78932BE062527B22.quest_desc: [
		"Craft it in the cauldron, then sneak-right-click it onto the cauldron top."
	]
	quest.7D485E86DA305EAB.title: "Candles"
	quest.7D485E86DA305EAB.quest_subtitle: "Dip string into tallow. Candles float around a lit altar and can carry potion effects"
	quest.7D485E86DA305EAB.quest_desc: [
		"Up to 4 candles fit in one block. They burn about 35 minutes; a &6Candelabra&r never goes out."
	]
	quest.3804E5BA4A68DF98.title: "&2Sage Burning Plate"
	quest.3804E5BA4A68DF98.quest_subtitle: "Light dried sage on the plate to stop monsters spawning in a 48-block radius"
	quest.3804E5BA4A68DF98.quest_desc: [
		"Bundle sage, dry the bundle on a rack, put it on the plate and light it with flint and steel."
	]
	quest.6F8BBA69CAC26FDE.title: "Seed Mixture"
	quest.6F8BBA69CAC26FDE.quest_subtitle: "Crows love it. Used to tame them"
	quest.6F8BBA69CAC26FDE.quest_desc: [
		"Grind seeds in the Pestle and Mortar."
	]
	quest.41E8B8A62D8BF3B5.title: "&8Crow Familiar"
	quest.41E8B8A62D8BF3B5.quest_subtitle: "Tame a crow with seed mixture, then command it with the Crow Flute"
	quest.41E8B8A62D8BF3B5.quest_desc: [
		"The flute picks crows, gives commands and sets perches. Crows on gather mode stock your coffers and herb jars."
	]
	quest.2A5F7D2C0DD5B62A.title: "Owl Post"
	quest.2A5F7D2C0DD5B62A.quest_subtitle: "Tame an owl with raw cod or salmon. Owls deliver letters and packages"
	quest.2A5F7D2C0DD5B62A.quest_desc: [
		"Look for an &6Owl Post Office&r in forests. Courier Letters, Packages and Depots handle deliveries."
	]
	quest.140EB912847BCE6E.title: "Witchy Storage"
	quest.140EB912847BCE6E.quest_subtitle: "Coffers keep their items when picked up; Herb Jars hold 1024 of one item"
	quest.140EB912847BCE6E.quest_desc: [
		"Craft them in the cauldron. Crows can keep them stocked."
	]
	quest.2746B3F84AB95677.title: "Selenite"
	quest.2746B3F84AB95677.quest_subtitle: "Found in selenite geodes under jungles and swamps"
	quest.2746B3F84AB95677.quest_desc: [
		"Dig into selenite geodes under jungles and swamps."
	]
	quest.10A883473C3DA899.title: "Crystal Ball"
	quest.10A883473C3DA899.quest_subtitle: "Shows the phase of the moon. Handy for making moon dust"
	quest.10A883473C3DA899.quest_desc: [
		"Craft it in a heated cauldron with selenite."
	]
	quest.16F8F7C9B4974B9C.title: "Infused Fabric"
	quest.16F8F7C9B4974B9C.quest_subtitle: "Used for the witch armor and decorative fabric blocks"
	quest.16F8F7C9B4974B9C.quest_desc: [
		"Make it in the Mixing Cauldron."
	]
	quest.60D0A8B123FB02AD.title: "&5Witch's Attire"
	quest.60D0A8B123FB02AD.quest_subtitle: "The full set gives perks. Each piece can be dyed"
	quest.60D0A8B123FB02AD.quest_desc: [
		"Craft the pieces from infused fabric and wear the whole set."
	]
	quest.1D88CA6B200B49CC.title: "Covens"
	quest.1D88CA6B200B49CC.quest_subtitle: "Find a Dark Coven and a Witch Hut in the swamps"
	quest.1D88CA6B200B49CC.quest_desc: [
		"Use the Dowsing Rod set to swamps, then explore."
	]
	chapter.1E277457E6BC233C.title: " &2Hexerei"
	quest.39AD1C9AF86DF37F.title: "&bGoo Science"
	quest.39AD1C9AF86DF37F.quest_subtitle: "Everything in Just Dire Things comes from &6Goo&r turning blocks into new materials"
	quest.39AD1C9AF86DF37F.quest_desc: [
		"&e1.&r Craft a Goo block and place it."
		"&e2.&r Feed it the item it shows to activate it."
		"&e3.&r Place an eligible block next to it and wait."
		"Each goo tier converts a stronger block: iron, then gold, diamond and netherite."
	]
	quest.514A39D635A5FCA1.title: "Primogel Goo"
	quest.514A39D635A5FCA1.quest_subtitle: "Tier 1 goo from overworld materials. Turns an &fIron Block&r into Raw Ferricore"
	quest.514A39D635A5FCA1.quest_desc: [
		"After each conversion there is a &e10%&r chance the goo needs feeding again."
	]
	quest.477B789D93A10796.title: "&7Ferricore"
	quest.477B789D93A10796.quest_subtitle: "Mine the Raw Ferricore Block and smelt the raw ferricore into ingots"
	quest.477B789D93A10796.quest_desc: [
		"Feed Primogel Goo, place an iron block next to it, wait, then mine the result."
	]
	quest.229455039B45885C.title: "&6Blazegold"
	quest.229455039B45885C.quest_subtitle: "&6Blazebloom Goo&r (tier 2) turns a &6Gold Block&r into Raw Blazegold"
	quest.229455039B45885C.quest_desc: [
		"Craft Blazebloom Goo, feed it, and place a gold block next to it."
	]
	quest.46D4C5594182D07D.title: "&dCelestigem"
	quest.46D4C5594182D07D.quest_subtitle: "&dVoidShimmer Goo&r (tier 3) turns a &bDiamond Block&r into Raw Celestigem"
	quest.46D4C5594182D07D.quest_desc: [
		"Craft VoidShimmer Goo, feed it, and place a diamond block next to it."
	]
	quest.477C6BED8D7CA850.title: "&5Eclipse Alloy"
	quest.477C6BED8D7CA850.quest_subtitle: "&5Shadowpulse Goo&r (tier 4) turns a &8Netherite Block&r into Raw Eclipse Alloy"
	quest.477C6BED8D7CA850.quest_desc: [
		"Higher-tier goo can do everything lower tiers can, and much faster."
	]
	quest.37A5CAC9B6DDF630.title: "Better Coal"
	quest.37A5CAC9B6DDF630.quest_subtitle: "Put a coal block next to goo: Primal Coal, then Blaze Ember, Voidflame and Eclipse Ember"
	quest.37A5CAC9B6DDF630.quest_desc: [
		"Each tier lasts longer and makes more FE in generators."
	]
	quest.2A1AE3B624877A3D.title: "Coal Generator"
	quest.2A1AE3B624877A3D.quest_subtitle: "Burns any furnace fuel, but goo coals give far more power"
	quest.2A1AE3B624877A3D.quest_desc: [
		"Place it, add fuel, and connect machines that need FE."
	]
	quest.426B0FDA3C07660D.title: "Pocket Generator"
	quest.426B0FDA3C07660D.quest_subtitle: "Keeps your powered tools and armor charged on the go. Feed it coal"
	quest.426B0FDA3C07660D.quest_desc: [
		"Open it and add coal or goo coals."
	]
	quest.51C2806E4730E161.title: "Energy Transmitter"
	quest.51C2806E4730E161.quest_subtitle: "Sends power wirelessly to every machine in its area (with a small loss)"
	quest.51C2806E4730E161.quest_desc: [
		"Connect it to a generator and set its area."
	]
	quest.706DC3ED9A2BF837.title: "Ferricore Tools"
	quest.706DC3ED9A2BF837.quest_subtitle: "Every material tier has tools and armor that take &eUpgrades&r"
	quest.706DC3ED9A2BF837.quest_desc: [
		"Hold &eShift&r on a tool to see which upgrades it accepts. Toggle a tool on and off with &eV&r."
	]
	quest.40DD44376A8E5B92.title: "Upgrades"
	quest.40DD44376A8E5B92.quest_subtitle: "Install upgrades in a &6Smithing Table&r. Some are activated, some are passive"
	quest.40DD44376A8E5B92.quest_desc: [
		"Example: Hammer mines 3x3 to 7x7, Mob Scanner shows nearby mobs. Look each one up in JEI."
	]
	quest.109B09B79E558570.title: "Tier Templates"
	quest.109B09B79E558570.quest_subtitle: "Upgrade a tool to the next tier in a Smithing Table and keep its installed upgrades"
	quest.109B09B79E558570.quest_desc: [
		"Combine the tool, template and new material in a Smithing Table."
	]
	quest.65F4A8E9986F2E51.title: "Ferricore Armor"
	quest.65F4A8E9986F2E51.quest_subtitle: "Blazegold armor repairs itself in lava; Celestigem and Eclipse armor run on FE"
	quest.65F4A8E9986F2E51.quest_desc: [
		"Craft the armor pieces from each tier's material."
	]
	quest.6E4ADC85952DB22D.title: "Ferricore Wrench"
	quest.6E4ADC85952DB22D.quest_subtitle: "Rotates blocks and links Swappers together"
	quest.6E4ADC85952DB22D.quest_desc: [
		"Sneak-right-click two swappers to link them."
	]
	quest.5310F71C179CDC93.title: "Simple Machines"
	quest.5310F71C179CDC93.quest_subtitle: "No power needed. They act on the block in front of them"
	quest.5310F71C179CDC93.quest_desc: [
		"Block Breakers need a tool inside. Set speed and redstone mode in each machine's UI."
	]
	quest.386FBBEA3CEB93BC.title: "Advanced Machines"
	quest.386FBBEA3CEB93BC.quest_subtitle: "Need power, but work over an area with filters. They also charge FE tools inside them"
	quest.386FBBEA3CEB93BC.quest_desc: [
		"Advanced machines need power and can affect an area. Set it in the UI."
	]
	quest.3C5F7DDF674BEB66.title: "Item Collector"
	quest.3C5F7DDF674BEB66.quest_subtitle: "Vacuums up dropped items in an area into the inventory it faces"
	quest.3C5F7DDF674BEB66.quest_desc: [
		"Place it next to a chest and set its area."
	]
	quest.3AB2296E9E3AC9EE.title: "Experience Holder"
	quest.3AB2296E9E3AC9EE.quest_subtitle: "Stores your experience levels"
	quest.3AB2296E9E3AC9EE.quest_desc: [
		"Put your levels in and take them out later."
	]
	quest.750186811B7F6AA0.title: "Settings Copier"
	quest.750186811B7F6AA0.quest_subtitle: "&eSneak-right-click&r a machine to copy its settings, right-click another to paste"
	quest.750186811B7F6AA0.quest_desc: [
		"Sneak-right-click a machine to copy, right-click another to paste."
	]
	quest.186A1E1A2153F7F6.title: "Creature Catcher"
	quest.186A1E1A2153F7F6.quest_subtitle: "Throw it at a mob to capture it; throw it again to release it"
	quest.186A1E1A2153F7F6.quest_desc: [
		"Throw it at a mob, then throw it again to release."
	]
	quest.20C65DCF0AF0B5F0.title: "Totem of Death Recall"
	quest.20C65DCF0AF0B5F0.quest_subtitle: "Binds to where you die. Hold right-click to teleport back"
	quest.20C65DCF0AF0B5F0.quest_desc: [
		"Keep it in your inventory. After you die, hold right-click to return."
	]
	quest.1ECE48DEDA9C39AE.title: "Blazejet Wand"
	quest.1ECE48DEDA9C39AE.quest_subtitle: "Right-click to air-burst yourself through the sky"
	quest.1ECE48DEDA9C39AE.quest_desc: [
		"Right-click to launch yourself."
	]
	quest.200FC7933FB55DB1.title: "Voidshift Wand"
	quest.200FC7933FB55DB1.quest_subtitle: "Teleport short distances, even through walls"
	quest.200FC7933FB55DB1.quest_desc: [
		"Aim and use it to teleport through blocks."
	]
	quest.7C23FADC9F07CCB0.title: "&dPortal Gun"
	quest.7C23FADC9F07CCB0.quest_subtitle: "Left click fires a blue portal, right click an orange one"
	quest.7C23FADC9F07CCB0.quest_desc: [
		"Left click and right click to place the two portals."
	]
	quest.45A86EB749ED98E3.title: "Polymorphic Fluid"
	quest.45A86EB749ED98E3.quest_subtitle: "Drop a Polymorphic Catalyst into water. It is the base for every special fluid"
	quest.45A86EB749ED98E3.quest_desc: [
		"Drop a Polymorphic Catalyst into a water source."
	]
	quest.357EFD4CF821E62C.title: "Portal Fluid"
	quest.357EFD4CF821E62C.quest_subtitle: "Fuels the Advanced Portal Gun. Stabilize it with VoidShimmer Goo or it breaks down outside the End"
	quest.357EFD4CF821E62C.quest_desc: [
		"Drop a Portal Fluid Catalyst into Polymorphic Fluid, then stabilize it with goo."
	]
	quest.3FC8E286F652252B.title: "Budding Time Crystal"
	quest.3FC8E286F652252B.quest_subtitle: "Shadowpulse Goo turns a Budding Amethyst into a Budding Time Crystal"
	quest.3FC8E286F652252B.quest_desc: [
		"It must soak up time energy in the &aOverworld&r, then the &cNether&r, then the &dEnd&r."
		"Breaking it shatters it, even with Silk Touch, so find another way to move it between dimensions."
	]
	quest.3198C9E871CC9300.title: "&5Time Crystals"
	quest.3198C9E871CC9300.quest_subtitle: "Let buds fully grow before breaking them. Drop a crystal in Polymorphic Fluid for Time Fluid"
	quest.3198C9E871CC9300.quest_desc: [
		"Move the Budding Time Crystal through all three dimensions, then grow and harvest the buds."
	]
	quest.6DB29FF6E531D57D.title: "Time Wand"
	quest.6DB29FF6E531D57D.quest_subtitle: "Speeds up time on blocks. Runs on FE and Time Fluid"
	quest.6DB29FF6E531D57D.quest_desc: [
		"Charge it with FE and Time Fluid, then use it on blocks."
	]
	chapter.6626E3F046DE9BAF.title: " &bJust Dire Things"
	quest.588126E989FE5DAD.title: "&6Prehistoric Life"
	quest.588126E989FE5DAD.quest_subtitle: "Dig up fossils, revive ancient creatures and tame dinosaurs"
	quest.588126E989FE5DAD.quest_desc: [
		"Three mods share this chapter: &6Unusual Prehistory&r, &bPelagic Prehistory&r (sea life) and &2Archie's Dinosaurs&r."
	]
	quest.38EBD7ABD9576794.title: "Fossil Beds"
	quest.38EBD7ABD9576794.quest_subtitle: "Found underground in four rarities: common, uncommon, rare and unusual"
	quest.38EBD7ABD9576794.quest_desc: [
		"Rarer beds hold rarer creatures. Look for them while caving."
	]
	quest.7AAD2D2E87F59D35.title: "Fossil Matrix"
	quest.7AAD2D2E87F59D35.quest_subtitle: "Matrix blocks hold fossils. Check JEI for how to get them out"
	quest.7AAD2D2E87F59D35.quest_desc: [
		"Mine matrix blocks and process them (JEI shows how) to get fossils."
	]
	quest.196C6B8C73861819.title: "Spiral Fossil"
	quest.196C6B8C73861819.quest_subtitle: "An ancient shell, waiting to come back to life"
	quest.196C6B8C73861819.quest_desc: [
		"Spiral fossils come from fossil matrix."
		"Next: the Transmogrifier."
	]
	quest.1E76576DFEEDC784.title: "&6Transmogrifier"
	quest.1E76576DFEEDC784.quest_subtitle: "Turns fossils into living eggs. A Spiral Fossil becomes Ammonite Eggs"
	quest.1E76576DFEEDC784.quest_desc: [
		"Put fossils and organic ooze in the Transmogrifier to get eggs."
	]
	quest.6A0C1772EA946F4C.title: "Living Fossil"
	quest.6A0C1772EA946F4C.quest_subtitle: "Hatch and find a living &6Ammonite&r"
	quest.6A0C1772EA946F4C.quest_desc: [
		"Hatch ammonite eggs in water and find the creature."
	]
	quest.62847191FAFD8FAE.title: "Gargantuan Fossil"
	quest.62847191FAFD8FAE.quest_subtitle: "Something huge once lived here..."
	quest.62847191FAFD8FAE.quest_desc: [
		"A rare find. JEI shows where it comes from."
	]
	quest.20C8CEC028999859.title: "&bAncient Sediment"
	quest.20C8CEC028999859.quest_subtitle: "Sea-floor stone that hides &bPelagic Fossils&r"
	quest.20C8CEC028999859.quest_desc: [
		"Ancient Sediment is found on the sea floor. Mine it for fossils."
	]
	quest.536C6497DBDF9F81.title: "&bAnalyzer"
	quest.536C6497DBDF9F81.quest_subtitle: "Analyze fossils to get DNA vials of ancient sea creatures"
	quest.536C6497DBDF9F81.quest_desc: [
		"Put Pelagic Fossils in the Analyzer to get DNA vials."
	]
	quest.50B6EF6B44D4CDEF.title: "DNA Vials"
	quest.50B6EF6B44D4CDEF.quest_subtitle: "Each vial holds one species"
	quest.50B6EF6B44D4CDEF.quest_desc: [
		"Different fossils give different vials. JEI shows the species."
	]
	quest.48B3B960BFEB85C3.title: "&bInfuser"
	quest.48B3B960BFEB85C3.quest_subtitle: "Infuses vials into eggs or pups"
	quest.48B3B960BFEB85C3.quest_desc: [
		"Infuse vials into eggs or pups."
	]
	quest.5915C161D8B8A9E0.title: "&bJurassic Ocean"
	quest.5915C161D8B8A9E0.quest_subtitle: "Bring back a &6Dunkleosteus&r and a &6Plesiosaurus&r"
	quest.5915C161D8B8A9E0.quest_desc: [
		"Hatch them in water and find them."
	]
	quest.10CA679C3108E992.title: "&2Meet Archie"
	quest.10CA679C3108E992.quest_subtitle: "Archie knows all about the dinosaurs in this world. Read &6Archie's Guidebook&r"
	quest.10CA679C3108E992.quest_desc: [
		"Find Archie and read his Guidebook. It explains every dinosaur."
	]
	quest.1828C61A52A95B9C.title: "Therimoss"
	quest.1828C61A52A95B9C.quest_subtitle: "Found in &2Jungle&r biomes"
	quest.1828C61A52A95B9C.quest_desc: [
		"Explore jungles to find one."
	]
	quest.1E44AAC1F1C67836.title: "Lushsaur"
	quest.1E44AAC1F1C67836.quest_subtitle: "Found in &aLush Caves&r"
	quest.1E44AAC1F1C67836.quest_desc: [
		"Explore lush caves to find one."
	]
	quest.13456E53C81843AE.title: "Coralosaur"
	quest.13456E53C81843AE.quest_subtitle: "Found in &bWarm Ocean&r biomes"
	quest.13456E53C81843AE.quest_desc: [
		"Search warm oceans."
	]
	quest.68AD1D7F9A3EC0D7.title: "Obsidiceratops"
